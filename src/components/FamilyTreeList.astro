---
import { formatDateFR } from "../utils/formatDate.ts";

const { node } = Astro.props;

interface Person {
  _id: string;
  prenom: string;
  nom: string;
  sexe?: string | null;
  dateNaissance?: string | null;
  dateDeces?: string | null;
  unionStatus?: string | null;
}

interface ChildGroup {
  coParent: Person | null;
  children: TreeNode[];
}

interface TreeNode {
  person: Person;
  conjoint?: Person | null;
  childGroups?: ChildGroup[];
}

// Sérialise l'arbre en JSON pour le JS client
const treeJson = JSON.stringify(node);
---

<div class="tl-wrapper">
  <div id="tree-list-root" data-tree={treeJson}></div>
</div>

<style>
  .tl-wrapper {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1rem 1.25rem;
    font-family: inherit;
  }

  /* ── Ligne personne ── */
  .tl-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.4rem;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.12s;
    user-select: none;
    position: relative;
  }
  .tl-row:hover { background: #f1f5f9; }
  .tl-row.is-root { background: #1e293b; border-radius: 8px; }
  .tl-row.is-root:hover { background: #334155; }

  /* ── Toggle ── */
  .tl-toggle {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6rem;
    color: #94a3b8;
    flex-shrink: 0;
    transition: transform 0.2s;
  }
  .tl-toggle.open { transform: rotate(90deg); }
  .tl-toggle-spacer { width: 18px; flex-shrink: 0; }

  /* ── Nom ── */
  .tl-name {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .tl-prenom {
    font-size: 0.68rem;
    color: #64748b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tl-nom {
    font-size: 0.82rem;
    font-weight: 600;
    color: #0f172a;
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tl-date {
    font-size: 0.6rem;
    color: #94a3b8;
  }

  .is-root .tl-prenom { color: #94a3b8; }
  .is-root .tl-nom    { color: #f1f5f9; }
  .is-root .tl-date   { color: #64748b; }

  /* ── Badges ── */
  .tl-badge {
    font-size: 0.6rem;
    padding: 0.1rem 0.45rem;
    border-radius: 9999px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .tl-badge--deceased {
    background: #334155;
    color: #94a3b8;
  }

  /* ── Conjoint ── */
  .tl-separator {
    font-size: 0.7rem;
    flex-shrink: 0;
  }
  .tl-separator--active   { color: #f43f5e; }
  .tl-separator--divorced { color: #94a3b8; }

  .tl-conjoint {
    display: flex;
    flex-direction: column;
    min-width: 0;
    opacity: 0.85;
  }
  .tl-conjoint .tl-prenom { color: #9f1239; }
  .tl-conjoint .tl-nom    { color: #881337; }

  .tl-conjoint--divorced .tl-prenom { color: #94a3b8; }
  .tl-conjoint--divorced .tl-nom    { color: #64748b; }

  /* ── Lien navigation ── */
  .tl-link {
    margin-left: auto;
    font-size: 0.65rem;
    color: #93c5fd;
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.12s;
    flex-shrink: 0;
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    background: rgba(148,163,184,0.1);
  }
  .tl-row:hover .tl-link { opacity: 1; }
  .is-root .tl-link { color: #93c5fd; }

  /* ── Enfants ── */
  .tl-children {
    padding-left: 1.5rem;
    border-left: 1.5px solid #e2e8f0;
    margin-left: 0.85rem;
    overflow: hidden;
    transition: max-height 0.25s ease, opacity 0.2s ease;
  }
  .tl-children.collapsed {
    max-height: 0 !important;
    opacity: 0;
    pointer-events: none;
  }

  /* ── Groupe de coParent ── */
  .tl-group-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.4rem;
    margin-top: 0.15rem;
    font-size: 0.65rem;
    color: #94a3b8;
    border-radius: 6px;
  }
  .tl-group-header span {
    font-weight: 500;
    color: #64748b;
  }

  /* ── Compteur enfants ── */
  .tl-child-count {
    font-size: 0.6rem;
    background: #e2e8f0;
    color: #64748b;
    padding: 0.05rem 0.4rem;
    border-radius: 9999px;
    margin-left: 0.25rem;
    flex-shrink: 0;
  }
  .is-root .tl-child-count {
    background: #334155;
    color: #94a3b8;
  }
</style>

<script>
  interface Person {
    _id: string;
    prenom: string;
    nom: string;
    dateNaissance?: string | null;
    dateDeces?: string | null;
    unionStatus?: string | null;
  }
  interface ChildGroup {
    coParent: Person | null;
    children: TreeNode[];
  }
  interface TreeNode {
    person: Person;
    conjoint?: Person | null;
    childGroups?: ChildGroup[];
  }

  function formatDate(d: string | null | undefined): string {
    if (!d) return '';
    try {
      return new Date(d).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
    } catch { return d; }
  }

  function totalDescendants(node: TreeNode): number {
    let n = 0;
    for (const g of node.childGroups ?? []) {
      n += g.children.length;
      for (const c of g.children) n += totalDescendants(c);
    }
    return n;
  }

  function buildNode(node: TreeNode, isRoot = false): HTMLElement {
    const wrapper = document.createElement('div');
    wrapper.className = 'tl-node';

    const allChildren = (node.childGroups ?? []).flatMap(g => g.children);
    const hasChildren = allChildren.length > 0;
    const desc = totalDescendants(node);

    // ── Ligne principale ──
    const row = document.createElement('div');
    row.className = `tl-row${isRoot ? ' is-root' : ''}`;

    // Toggle
    if (hasChildren) {
      const toggle = document.createElement('div');
      toggle.className = 'tl-toggle open';
      toggle.innerHTML = '▶';
      row.appendChild(toggle);
    } else {
      const spacer = document.createElement('div');
      spacer.className = 'tl-toggle-spacer';
      row.appendChild(spacer);
    }

    // Nom personne
    const name = document.createElement('div');
    name.className = 'tl-name';
    name.innerHTML = `
      <span class="tl-prenom">${node.person.prenom}</span>
      <span class="tl-nom">${node.person.nom.toUpperCase()}</span>
      ${node.person.dateDeces ? `<span class="tl-date">† ${formatDate(node.person.dateDeces)}</span>` : ''}
    `;
    row.appendChild(name);

    // Badge décédé
    if (node.person.dateDeces) {
      const badge = document.createElement('span');
      badge.className = 'tl-badge tl-badge--deceased';
      badge.textContent = '✝';
      row.appendChild(badge);
    }

    // Compteur descendants
    if (hasChildren) {
      const count = document.createElement('span');
      count.className = 'tl-child-count';
      count.textContent = `${desc} pers.`;
      row.appendChild(count);
    }

    // Conjoint(s) inline — on affiche le premier conjoint simple
    const groupCoParentIds = new Set(
      (node.childGroups ?? []).map(g => g.coParent?._id).filter(Boolean)
    );
    const singleGroups = (node.childGroups ?? []).filter(g => g.coParent);
    const extraConjoint = node.conjoint && !groupCoParentIds.has(node.conjoint._id) ? node.conjoint : null;
    const allConjoints: Person[] = [
      ...singleGroups.map(g => g.coParent!),
      ...(extraConjoint ? [extraConjoint] : []),
    ];

    if (allConjoints.length === 1) {
      const cp = allConjoints[0];
      const isDivorced = cp.unionStatus === 'DIVORCED';
      const sep = document.createElement('div');
      sep.className = `tl-separator tl-separator--${isDivorced ? 'divorced' : 'active'}`;
      sep.textContent = isDivorced ? '✂' : '♥';
      row.appendChild(sep);

      const cpName = document.createElement('div');
      cpName.className = `tl-name tl-conjoint${isDivorced ? ' tl-conjoint--divorced' : ''}`;
      cpName.innerHTML = `
        <span class="tl-prenom">${cp.prenom}</span>
        <span class="tl-nom">${cp.nom.toUpperCase()}</span>
        ${cp.dateDeces ? `<span class="tl-date">† ${formatDate(cp.dateDeces)}</span>` : ''}
      `;
      row.appendChild(cpName);
    } else if (allConjoints.length > 1) {
      // Plusieurs unions : afficher juste le nombre
      const sep = document.createElement('div');
      sep.className = 'tl-separator tl-separator--active';
      sep.textContent = `♥ ×${allConjoints.length}`;
      row.appendChild(sep);
    }

    // Lien vers /tree/[id]
    const link = document.createElement('a');
    link.className = 'tl-link';
    link.href = `/tree/${node.person._id}`;
    link.textContent = '🌳 arbre';
    link.addEventListener('click', e => e.stopPropagation());
    row.appendChild(link);

    wrapper.appendChild(row);

    // ── Enfants ──
    if (hasChildren) {
      const childrenWrapper = document.createElement('div');
      childrenWrapper.className = 'tl-children';
      let maxHeight = 0;

      const multiGroup = (node.childGroups ?? []).length > 1 || 
        ((node.childGroups ?? []).length === 1 && extraConjoint);

      for (const group of node.childGroups ?? []) {
        // Header de groupe si plusieurs unions
        if (multiGroup && group.coParent) {
          const header = document.createElement('div');
          header.className = 'tl-group-header';
          const isDivorced = group.coParent.unionStatus === 'DIVORCED';
          header.innerHTML = `
            ${isDivorced ? '✂' : '♥'}
            <span>avec ${group.coParent.prenom} ${group.coParent.nom.toUpperCase()}</span>
          `;
          childrenWrapper.appendChild(header);
          maxHeight += 30;
        }

        for (const child of group.children) {
          const childEl = buildNode(child, false);
          childrenWrapper.appendChild(childEl);
          maxHeight += 200; // estimation généreuse
        }
      }

      childrenWrapper.style.maxHeight = maxHeight + 'px';

      // Toggle click
      row.addEventListener('click', () => {
        const toggle = row.querySelector('.tl-toggle');
        const collapsed = childrenWrapper.classList.toggle('collapsed');
        toggle?.classList.toggle('open', !collapsed);
      });

      wrapper.appendChild(childrenWrapper);
    }

    return wrapper;
  }

  // Init
  const root = document.getElementById('tree-list-root');
  if (root) {
    const treeData: TreeNode = JSON.parse(root.dataset.tree ?? '{}');
    root.appendChild(buildNode(treeData, true));
  }
</script>