---
const { id, type,title } = Astro.props;

const isDisabled=type ? false:true
const isDisabledStyle="opacity-50 cursor-not-allowed"
---

<button
  class=`delete-${type}-btn px-2 py-1 bg-red-500 text-white rounded hover:bg-red-600 ${isDisabled ? isDisabledStyle : ""}`
  data-id={id}
  disabled={isDisabled}
>
  Supprimer 
</button>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.delete-relation-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm("Voulez-vous vraiment supprimer cette relation ?")) return;
        const relationId = (btn as HTMLElement).dataset.id;
        await fetch(`/api/relations/${relationId}`, { method: 'DELETE' });
        location.reload();
      });
    });

    document.querySelectorAll('.delete-person-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm("Voulez-vous vraiment supprimer cette personne ?")) return;
        const personId = (btn as HTMLElement).dataset.id;
        await fetch(`/api/persons/${personId}`, { method: 'DELETE' });
        location.reload();
      });
    });
  });
</script>