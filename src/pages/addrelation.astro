---
import Baselayout from "../layouts/Baselayout.astro";
import { persons as personsCol, relations as relationsCol } from "../lib/mongo";

const persons = await personsCol.find({ active: true }).toArray();
const coupleRelations = await relationsCol.find({ type: "CONJOINT" }).toArray();

// Calcul de majorité
function isMajeur(dateNaissance?: string): boolean {
  if (!dateNaissance) return true; // date inconnue → on ne bloque pas
  const birth = new Date(dateNaissance);
  const majority = new Date(birth);
  majority.setFullYear(majority.getFullYear() + 18);
  return majority <= new Date();
}

const personsData = persons.map(p => ({
  _id: p._id!.toString(),
  prenom: p.prenom,
  nom: p.nom,
  sexe: p.sexe,
  dateNaissance: p.dateNaissance,
  majeur: isMajeur(p.dateNaissance)
}));

// Séparer majeurs et mineurs
const majeurs = personsData.filter(p => p.majeur);

const coupleRelationsData = coupleRelations.map(r => {
  const p1 = personsData.find(p => p._id === r.from.toString());
  const p2 = personsData.find(p => p._id === r.to.toString());
  return {
    _id: r._id!.toString(),
    label: p1 && p2
      ? `${p1.prenom} ${p1.nom} & ${p2.prenom} ${p2.nom}${r.status === 'DIVORCED' ? ' (divorcés)' : ''}`
      : r._id!.toString()
  };
});
---
---

<Baselayout title="Ajouter une relation">
  <h2 class="text-2xl font-bold mb-6">Ajouter une relation</h2>

  <form id="relationForm" class="bg-white shadow-md p-6 rounded-md max-w-lg space-y-5">

    <!-- Type -->
    <div class="flex flex-col">
      <label class="mb-1 font-medium text-gray-700">Type de relation</label>
      <select name="type" id="type" class="border border-gray-300 rounded-md px-3 py-2">
        <option value="PARENT">👨‍👧 Déclarer un enfant</option>
        <option value="CONJOINT">💍 Déclarer un(e) conjoint(e)</option>
      </select>
    </div>

    <!-- ========== BLOC PARENT ========== -->
    <div id="parentFields" class="space-y-4">

      <!-- Enfant -->
      <div class="flex flex-col">
        <label class="mb-1 font-medium text-gray-700">Enfant</label>
        <select name="child" id="child" class="capitalize border border-gray-300 rounded-md px-3 py-2">
          {personsData.map(p => <option value={p._id}>{p.prenom}&nbsp;{p.nom}</option>)}
        </select>
      </div>

      <div class="border-t pt-4 space-y-4">
        <p class="text-sm text-gray-500 font-medium uppercase tracking-wide">Parents de cet enfant</p>

        <!-- Parent 1 -->
        <div class="flex flex-col">
          <label class="mb-1 font-medium text-gray-700">Parent 1</label>
          <select name="parent1" id="parent1" class="capitalize border border-gray-300 rounded-md px-3 py-2">
            <option value="">— Non renseigné —</option>
            {personsData.map(p => <option value={p._id}>{p.prenom}&nbsp;{p.nom}</option>)}
          </select>
        </div>

        <!-- Parent 2 -->
        <div class="flex flex-col">
          <label class="mb-1 font-medium text-gray-700">Parent 2</label>
          <select name="parent2" id="parent2" class="capitalize border border-gray-300 rounded-md px-3 py-2">
            <option value="">— Non renseigné —</option>
            {personsData.map(p => <option value={p._id}>{p.prenom}&nbsp;{p.nom}</option>)}
          </select>
        </div>

        <!-- Lier à un couple existant -->
        <div class="flex flex-col">
          <label class="mb-1 font-medium text-gray-700">
            Issu de l'union <span class="text-gray-400 font-normal">(optionnel)</span>
          </label>
          <select name="coupleRelationId" id="coupleRelationId" class="capitalize border border-gray-300 rounded-md px-3 py-2">
            <option value="">— Non précisé —</option>
            {coupleRelationsData.map(r => <option value={r._id}>{r.label}</option>)}
          </select>
          <p class="text-xs text-gray-400 mt-1">
            Si le couple est déjà enregistré, sélectionne-le pour lier automatiquement les enfants.
          </p>
        </div>
      </div>
    </div>

    <!-- ========== BLOC CONJOINT ========== -->
    <div id="conjointFields" class="hidden space-y-4">

      <div class="flex flex-col">
        <label class="mb-1 font-medium text-gray-700">Conjoint(e) A</label>
        <select name="from" id="from" class="capitalize border border-gray-300 rounded-md px-3 py-2">
          {majeurs.map(p => <option value={p._id}>{p.prenom}&nbsp;{p.nom}</option>)}
        </select>
      </div>

      <div class="flex flex-col">
        <label class="mb-1 font-medium text-gray-700">Conjoint(e) B</label>
        <select name="to" id="to" class="capitalize border border-gray-300 rounded-md px-3 py-2">
          {majeurs.map(p => <option  value={p._id}>{p.prenom}&nbsp;{p.nom}</option>)}
        </select>
      </div>

      <div class="border-t pt-4 space-y-4">
        <p class="text-sm text-gray-500 font-medium uppercase tracking-wide">Options union</p>

        <div class="flex flex-col">
          <label class="mb-1 font-medium text-gray-700">Statut</label>
          <select name="status" id="status" class="border border-gray-300 rounded-md px-3 py-2">
            <option value="ACTIVE">✅ En couple</option>
            <option value="DIVORCED">❌ Divorcé(e) / Séparé(e)</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Date de début</label>
            <input type="date" name="dateDebut" id="dateDebut" class="border border-gray-300 rounded-md px-3 py-2" />
          </div>
          <div class="flex flex-col">
            <label class="mb-1 font-medium text-gray-700">Date de fin</label>
            <input type="date" name="dateFin" id="dateFin" class="border border-gray-300 rounded-md px-3 py-2" />
          </div>
        </div>
      </div>
    </div>

    <button
      type="submit"
      class="bg-blue-600 text-white font-semibold px-4 py-2 rounded-md hover:bg-blue-700 transition-colors w-full"
    >
      Créer
    </button>
  </form>
</Baselayout>

<script>
  const form = document.getElementById("relationForm") as HTMLFormElement;
  const typeSelect = document.getElementById("type") as HTMLSelectElement;
  const parentFields = document.getElementById("parentFields")!;
  const conjointFields = document.getElementById("conjointFields")!;
  const statusSelect = document.getElementById("status") as HTMLSelectElement;
  const dateFinInput = document.getElementById("dateFin") as HTMLInputElement;
  const fromSelect = document.getElementById("from") as HTMLSelectElement;
  const toSelect = document.getElementById("to") as HTMLSelectElement;
  const parent1Select = document.getElementById("parent1") as HTMLSelectElement;
  const parent2Select = document.getElementById("parent2") as HTMLSelectElement;
  const childSelect = document.getElementById("child") as HTMLSelectElement;

  // --- Affichage selon le type ---
  function updateTypeUI() {
    if (typeSelect.value === "CONJOINT") {
      parentFields.classList.add("hidden");
      conjointFields.classList.remove("hidden");
    } else {
      parentFields.classList.remove("hidden");
      conjointFields.classList.add("hidden");
    }
  }
  typeSelect.addEventListener("change", updateTypeUI);
  updateTypeUI();

  // --- Désactiver dateFin si ACTIVE ---
  statusSelect.addEventListener("change", () => {
    dateFinInput.disabled = statusSelect.value === "ACTIVE";
    if (statusSelect.value === "ACTIVE") dateFinInput.value = "";
  });

  // --- Empêcher les doublons dans les selects conjoint ---
  fromSelect.addEventListener("change", () => {
    Array.from(toSelect.options).forEach(o => o.disabled = o.value === fromSelect.value);
  });

  // --- Empêcher les doublons parent1/parent2/child ---
  function syncParentSelects() {
    const childVal = childSelect.value;
    const p1Val = parent1Select.value;
    const p2Val = parent2Select.value;

    Array.from(parent1Select.options).forEach(o =>
      o.disabled = o.value !== "" && (o.value === p2Val || o.value === childVal)
    );
    Array.from(parent2Select.options).forEach(o =>
      o.disabled = o.value !== "" && (o.value === p1Val || o.value === childVal)
    );
    Array.from(childSelect.options).forEach(o =>
      o.disabled = o.value === p1Val || o.value === p2Val
    );
  }
  parent1Select.addEventListener("change", syncParentSelects);
  parent2Select.addEventListener("change", syncParentSelects);
  childSelect.addEventListener("change", syncParentSelects);

  // --- Soumission ---
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const type = fd.get("type") as string;

    try {
      if (type === "CONJOINT") {
        const from = fd.get("from") as string;
        const to = fd.get("to") as string;

        if (from === to) {
          alert("Les deux conjoints doivent être différents !");
          return;
        }

        const payload: any = { type, from, to, status: fd.get("status") };
        const dateDebut = fd.get("dateDebut") as string;
        const dateFin = fd.get("dateFin") as string;
        if (dateDebut) payload.dateDebut = dateDebut;
        if (dateFin) payload.dateFin = dateFin;

        const res = await fetch("/api/relations", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        if (!res.ok) throw new Error(await res.text());

      } else {
        // PARENT : on crée 1 ou 2 relations selon les parents renseignés
        const child = fd.get("child") as string;
        const parent1 = fd.get("parent1") as string;
        const parent2 = fd.get("parent2") as string;
        const coupleRelationId = fd.get("coupleRelationId") as string;

        if (!parent1 && !parent2) {
          alert("Renseigne au moins un parent !");
          return;
        }

        const parents = [parent1, parent2].filter(Boolean);

        for (const parentId of parents) {
          if (parentId === child) {
            alert("Un parent ne peut pas être son propre enfant !");
            return;
          }
          const payload: any = { type: "PARENT", from: parentId, to: child };
          if (coupleRelationId) payload.coupleRelationId = coupleRelationId;

          const res = await fetch("/api/relations", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
          if (!res.ok) throw new Error(await res.text());
        }
      }

      alert("✅ Relation(s) créée(s) !");
      form.reset();
      updateTypeUI();

    } catch (err) {
      alert(`❌ Erreur : ${err}`);
    }
  });
</script>