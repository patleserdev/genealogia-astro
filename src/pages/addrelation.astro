---
import Baselayout from "../layouts/Baselayout.astro";
import { persons as personsCol, relations as relationsCol } from "../lib/mongo";
import { ObjectId } from "mongodb";
import { formatDateForInput } from "../utils/formatDate.ts";

export const prerender = false;

const relationId = Astro.url.searchParams.get("id");
const returnUrl = Astro.url.searchParams.get("returnUrl") || "/relations";
// Charger personnes
const persons = await personsCol.find({ active: true }).toArray();

// Charger relation si édition
let relation = null;
if (relationId && ObjectId.isValid(relationId)) {
  relation = await relationsCol.findOne({ _id: new ObjectId(relationId) });
}

// Charger couples existants
const coupleRelations = await relationsCol.find({ type: "CONJOINT" }).toArray();

// Fonction majorité
function isMajeur(dateNaissance?: string): boolean {
  if (!dateNaissance) return true;
  const birth = new Date(dateNaissance);
  const majority = new Date(birth);
  majority.setFullYear(majority.getFullYear() + 18);
  return majority <= new Date();
}

// Mapper persons
const personsData = persons.map((p) => ({
  _id: p._id!.toString(),
  prenom: p.prenom,
  nom: p.nom,
  sexe: p.sexe,
  dateNaissance: p.dateNaissance,
  majeur: isMajeur(p.dateNaissance),
}));

const majeurs = personsData.filter((p) => p.majeur);

const coupleRelationsData = coupleRelations.map((r) => {
  const p1 = personsData.find((p) => p._id === r.from.toString());
  const p2 = personsData.find((p) => p._id === r.to.toString());
  return {
    _id: r._id!.toString(),
    label:
      p1 && p2
        ? `${p1.prenom} ${p1.nom} & ${p2.prenom} ${p2.nom}${r.status === "DIVORCED" ? " (divorcés)" : ""}`
        : r._id!.toString(),
  };
});
---

<Baselayout title={relation ? "Modifier une relation" : "Ajouter une relation"}>
  <div class="max-w-2xl mx-auto">
    <h2 class="text-3xl font-bold mb-6 text-gray-800">
      {relation ? "✏️ Modifier une relation" : "➕ Ajouter une relation"}
    </h2>

    <form
      id="relationForm"
      class="bg-white shadow-xl rounded-2xl p-8 space-y-8 border"
    >
      <!-- TYPE -->
      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-2">
          Type de relation
        </label>
        <select
          name="type"
          id="type"
          class="w-full rounded-lg border-gray-300 focus:ring-2 focus:ring-blue-500"
        >
          <option value="PARENT" selected={relation?.type === "PARENT"}
            >👨‍👧 Parent</option
          >
          <option value="CONJOINT" selected={relation?.type === "CONJOINT"}
            >💍 Conjoint</option
          >
        </select>
      </div>

      <!-- ================= PARENT ================= -->
      <div id="parentFields" class="space-y-6">
        <div class="bg-gray-50 rounded-xl p-5 border space-y-4">
          <h3
            class="text-sm font-semibold text-gray-500 uppercase tracking-wide"
          >
            Relation parent / enfant
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-600 mb-1"
                >Enfant</label
              >
              <select
                name="child"
                id="child"
                class="w-full rounded-lg border-gray-300"
              >
                {
                  personsData.map((p) => (
                    <option
                      value={p._id}
                      selected={relation?.to?.toString() === p._id}
                    >
                      {p.prenom} {p.nom}
                    </option>
                  ))
                }
              </select>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-600 mb-1"
                >Parent</label
              >
              <select
                name="parent1"
                id="parent1"
                class="w-full rounded-lg border-gray-300"
              >
                <option value="">— Non renseigné —</option>
                {
                  personsData.map((p) => (
                    <option
                      value={p._id}
                      selected={relation?.from?.toString() === p._id}
                    >
                      {p.prenom} {p.nom}
                    </option>
                  ))
                }
              </select>
            </div>
            
          </div>
        </div>
      </div>

      <!-- ================= CONJOINT ================= -->
      <div id="conjointFields" class="hidden space-y-6">
        <div class="bg-gray-50 rounded-xl p-5 border space-y-4">
          <h3
            class="text-sm font-semibold text-gray-500 uppercase tracking-wide"
          >
            Relation de couple
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-600 mb-1"
                >Conjoint A</label
              >
              <select
                name="from"
                id="from"
                class="w-full rounded-lg border-gray-300"
              >
                {
                  majeurs.map((p) => (
                    <option
                      value={p._id}
                      selected={relation?.from?.toString() === p._id}
                    >
                      {p.prenom} {p.nom}
                    </option>
                  ))
                }
              </select>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-600 mb-1"
                >Conjoint B</label
              >
              <select
                name="to"
                id="to"
                class="w-full rounded-lg border-gray-300"
              >
                {
                  majeurs.map((p) => (
                    <option
                      value={p._id}
                      selected={relation?.to?.toString() === p._id}
                    >
                      {p.prenom} {p.nom}
                    </option>
                  ))
                }
              </select>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-600 mb-1"
              >Statut</label
            >
            <select
              name="status"
              id="status"
              class="w-full rounded-lg border-gray-300"
            >
              <option value="ACTIVE" selected={relation?.status === "ACTIVE"}
                >✅ En couple</option
              >
              <option
                value="DIVORCED"
                selected={relation?.status === "DIVORCED"}>❌ Divorcé</option
              >
            </select>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-600 mb-1"
                >Date de début</label
              >
              <input
                type="date"
                name="dateDebut"
                value={formatDateForInput(relation?.dateDebut)}
                class="w-full rounded-lg border-gray-300"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-600 mb-1"
                >Date de fin</label
              >
              <input
                type="date"
                name="dateFin"
                value={formatDateForInput(relation?.dateFin)}
                class="w-full rounded-lg border-gray-300"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- BOUTON -->
      <div class="mt-4 flex flex-col gap-4">
        <button
          type="submit"
          class="w-full bg-blue-600 text-white font-semibold py-3 rounded-xl hover:bg-blue-700 transition shadow-md"
        >
          {
            relation
              ? "💾 Enregistrer les modifications"
              : "➕ Créer la relation"
          }
        </button>

        <!-- Bouton Annuler intelligent -->
        <a
          href={returnUrl}
          class="block text-center text-sm text-gray-500 hover:underline"
        >
          Annuler
        </a>
      </div>
    </form>
  </div>
  <script define:vars={{ relationId, returnUrl }}>
    const form = document.getElementById("relationForm");
    const typeSelect = document.getElementById("type");
    const parentFields = document.getElementById("parentFields");
    const conjointFields = document.getElementById("conjointFields");

    function updateTypeUI() {
      if (typeSelect.value === "CONJOINT") {
        parentFields.classList.add("hidden");
        conjointFields.classList.remove("hidden");
      } else {
        parentFields.classList.remove("hidden");
        conjointFields.classList.add("hidden");
      }
    }
    updateTypeUI();
    typeSelect.addEventListener("change", updateTypeUI);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const type = fd.get("type");

      let payload = {};

      if (type === "CONJOINT") {
        payload = {
          type,
          from: fd.get("from"),
          to: fd.get("to"),
          status: fd.get("status"),
          dateDebut: fd.get("dateDebut") ? new Date(fd.get("dateDebut")) : null,
          dateFin: fd.get("dateFin") ? new Date(fd.get("dateFin")) : null,
          
        };
      } else {
        payload = {
          type: "PARENT",
          status:fd.get("status"),
          from: fd.get("parent1"),
          to: fd.get("child"),
        };
      }

      const url = relationId
        ? `/api/relations/${relationId}`
        : "/api/relations";
      const method = relationId ? "PATCH" : "POST";

      const res = await fetch(url, {
        method,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        alert(await res.text());
        return;
      }

      alert(relationId ? "Relation modifiée" : "Relation créée");
      window.location.href = returnUrl;
    });
  </script>
</Baselayout>
