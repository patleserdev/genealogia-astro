---
import Baselayout from "../layouts/Baselayout.astro";


const persons = await (await fetch("http://localhost:4321/api/persons")).json();
---

<Baselayout title="Ajouter une relation">
  <h2 class="text-2xl font-bold mb-4">Ajouter une relation</h2>

  <form id="relationForm" class="bg-white shadow-md p-6 rounded-md max-w-md space-y-4">
    <!-- De -->
    <div class="flex flex-col">
      <label for="from" class="mb-1 font-medium text-gray-700">De</label>
      <select name="from" id="from" class="border border-gray-300 rounded-md px-3 py-2">
        {persons.map(p => <option value={p._id}>{p.prenom} {p.nom}</option>)}
      </select>
    </div>

    <!-- Vers -->
    <div class="flex flex-col">
      <label for="to" class="mb-1 font-medium text-gray-700">Vers</label>
      <select name="to" id="to" class="border border-gray-300 rounded-md px-3 py-2">
        {persons.map(p => <option value={p._id}>{p.prenom} {p.nom}</option>)}
      </select>
    </div>

    <!-- Type -->
    <div class="flex flex-col">
      <label for="type" class="mb-1 font-medium text-gray-700">Type</label>
      <select name="type" class="border border-gray-300 rounded-md px-3 py-2">
        <option value="PARENT">Parent</option>
        <option value="CONJOINT">Conjoint</option>
      </select>
    </div>

    <button
      type="submit"
      class="bg-blue-600 text-white font-semibold px-4 py-2 rounded-md hover:bg-blue-700 transition-colors w-full"
    >
      Créer
    </button>
  </form>
</Baselayout>

<script>
  const form = document.getElementById("relationForm")  as HTMLFormElement;
  const fromSelect = document.getElementById("from") as HTMLFormElement;
  const toSelect = document.getElementById("to");

  // Empêche de sélectionner la même personne dans "to" que dans "from"
  fromSelect.addEventListener("change", () => {
    const fromValue = fromSelect.value;
    Array.from(toSelect.options).forEach(opt => {
      opt.disabled = opt.value === fromValue;
    });
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const data = Object.fromEntries(new FormData(form));

    // Vérification côté frontend
    if (data.from === data.to) {
      alert("Impossible de créer une relation avec la même personne !");
      return;
    }

    await fetch("/api/relations", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data)
    });

    alert("Relation créée !");
    // Optionnel : reset formulaire
    form.reset();
  });
</script>
