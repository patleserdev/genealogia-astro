---
import { ObjectId } from "mongodb";
import { verifyToken } from "../lib/auth.ts";
import { users } from "../lib/mongo.ts";
import Baselayout from "../layouts/Baselayout.astro";



const token = Astro.cookies.get("token")?.value;
if (!token) return Astro.redirect("/login");

let payload;
try {
  payload = verifyToken(token);
} catch {
  return Astro.redirect("/login");
}

if (payload.role !== "OWNER") {
  return Astro.redirect("/");
}

const filter = Astro.url.searchParams.get("filter");
let query: any = {};
if (filter === "invitedByMe") {
  query.invitedBy = new ObjectId(payload.userId);
}

const data = await users
  .find(query)
  .sort({ createdAt: -1 })
  .toArray();

function formatRole(role: string) {
  if (role === "OWNER") {
    return { label: "Owner", color: "bg-amber-50 text-amber-700" };
  }
  return { label: "Guest", color: "bg-stone-100 text-stone-500" };
}

const activeFilter = filter ?? "all";
---

<Baselayout title="Utilisateurs">
  <div class="max-w-4xl mx-auto px-6 py-8 space-y-6">

    <!-- Header -->
    <div class="flex items-center justify-between gap-3 flex-wrap">
        <div>
          <h1 class="text-2xl font-semibold text-stone-800 tracking-tight">
            Utilisateurs
          </h1>
          <p class="text-sm text-stone-500 mt-0.5">
            {data.length} utilisateur{data.length > 1 ? "s" : ""}
          </p>
        </div>
      </div>
      
      <!-- SEARCH + SORT -->
      <div class="flex gap-3">
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400"
            fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
          </svg>
      
          <input
            id="search-input"
            type="text"
            placeholder="Rechercher nom, prénom ou email…"
            class="w-full pl-9 pr-4 py-2.5 rounded-lg border border-stone-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
          />
        </div>
      
        <button
          id="sort-toggle"
          data-order="asc"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-stone-200 bg-white text-sm text-stone-600 hover:bg-stone-50 transition"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"/>
          </svg>
          <span id="sort-label">A → Z</span>
        </button>
      </div>
      <div class="flex gap-2 text-sm">

        <a
          href="/users"
          class={`px-3 py-1 rounded-lg border transition ${
            activeFilter === "all"
              ? "bg-stone-900 text-white border-stone-900"
              : "bg-white text-stone-600 hover:bg-stone-50"
          }`}
        >
          Tous
        </a>
      
        <a
          href="/users?filter=invitedByMe"
          class={`px-3 py-1 rounded-lg border transition ${
            activeFilter === "invitedByMe"
              ? "bg-amber-600 text-white border-amber-600"
              : "bg-white text-stone-600 hover:bg-stone-50"
          }`}
        >
          Invités par moi
        </a>
      
      </div>

    <!-- Liste -->
    <div class="space-y-2">
      {data
      .map((u) => {
        const role = formatRole(u.role);
        return (
        <div
  class="user-card bg-white border border-stone-200 rounded-xl px-4 py-3 sm:px-5 sm:py-4 flex items-center justify-between hover:border-stone-300 hover:shadow-sm transition"
  data-nom={u.nom.toLowerCase()}
  data-prenom={u.prenom.toLowerCase()}
  data-email={u.email?.toLowerCase() ?? ""}
>

            <!-- Left -->
            <div class="flex items-center gap-3 min-w-0">

              <!-- Avatar -->
              <div class="w-9 h-9 rounded-full bg-amber-50 border border-amber-100 flex items-center justify-center shrink-0">
                <span class="text-sm font-medium text-amber-700">
                  {u.prenom?.charAt(0)?.toUpperCase()}
                  {u.nom?.charAt(0)?.toUpperCase()}
                </span>
              </div>

              <!-- Infos -->
              <div class="min-w-0">
                <p class="text-sm font-medium text-stone-800 capitalize truncate">
                  {u.prenom} {u.nom}
                </p>

                <div class="flex items-center gap-2 text-xs text-stone-400">
                  {u.email && <span class="truncate">{u.email}</span>}
                  <span>•</span>
                  <span>
                    inscrit le{" "}
                    {new Date(u.createdAt).toLocaleDateString("fr-FR")}
                  </span>
                </div>
              </div>
            </div>

            <!-- Right -->
            <div class="flex items-center gap-2">

              <!-- Role badge -->
              <span class={`px-2 py-1 rounded-md text-xs font-medium ${role.color}`}>
                {role.label}
              </span>

              <!-- Actions -->
              <a
                href={`/users/${u._id}`}
                class="p-2 rounded-lg text-stone-500 hover:text-stone-800 hover:bg-stone-100 transition"
                title="Voir"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </a>

              <!-- DELETE -->
              <button
                data-id={u._id}
                class="delete-user p-2 rounded-lg text-stone-500 hover:text-red-600 hover:bg-red-50 transition"
                title="Supprimer"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>

            </div>
          </div>
        );
      })}
    </div>

  </div>
</Baselayout>

<script>
  const searchInput = document.getElementById("search-input");
  const sortToggle  = document.getElementById("sort-toggle");
  const sortLabel   = document.getElementById("sort-label");
  const list        = document.querySelector(".space-y-2");

  function getCards() {
    return Array.from(list.querySelectorAll(".user-card"));
  }

  function applyFilterAndSort() {
    const query = searchInput.value.toLowerCase().trim();
    const order = sortToggle.dataset.order;

    const cards = getCards();

    // FILTER
    cards.forEach(card => {
      const match =
        card.dataset.nom.includes(query) ||
        card.dataset.prenom.includes(query) ||
        card.dataset.email.includes(query);

      card.style.display = match ? "" : "none";
    });

    const visible = cards.filter(c => c.style.display !== "none");

    // SORT
    visible.sort((a, b) => {
      const aKey = (a.dataset.prenom + a.dataset.nom);
      const bKey = (b.dataset.prenom + b.dataset.nom);

      return order === "asc"
        ? aKey.localeCompare(bKey, "fr")
        : bKey.localeCompare(aKey, "fr");
    });

    visible.forEach(card => list.appendChild(card));
  }

  searchInput.addEventListener("input", applyFilterAndSort);

  sortToggle.addEventListener("click", () => {
    const isAsc = sortToggle.dataset.order === "asc";
    sortToggle.dataset.order = isAsc ? "desc" : "asc";
    sortLabel.textContent = isAsc ? "Z → A" : "A → Z";
    applyFilterAndSort();
  });

  const deleteButtons = document.querySelectorAll(".delete-user");

deleteButtons.forEach((btn) => {
  btn.addEventListener("click", async () => {
    const id = btn.dataset.id;

    if (!confirm("Supprimer cet utilisateur ?")) return;

    btn.disabled = true;

    const res = await fetch(`/api/users/${id}`, {
      method: "DELETE",
    });

    if (res.ok) {
      // 🔥 remove UI instant
      btn.closest(".user-card")?.remove();
    } else {
      const err = await res.json();
      alert(err.error || "Erreur suppression");
      btn.disabled = false;
    }
  });
});
</script>