---
import { ObjectId } from "mongodb";
import DeleteButton from "../components/DeleteButton.astro";
import Baselayout from "../layouts/Baselayout.astro";
import { verifyToken } from "../lib/auth.ts";
import { db, persons } from "../lib/mongo";
import { formatDateFR } from "../utils/formatDate";

const token = Astro.cookies.get('token')?.value
if (!token) return Astro.redirect('/login')

try {
  const payload = verifyToken(token)
  await db.collection('users').findOne({ _id: new ObjectId(payload.userId) })
} catch {
  return Astro.redirect('/login')
}

function calcAge(from: Date, to: Date) {
  let years  = to.getFullYear() - from.getFullYear();
  let months = to.getMonth() - from.getMonth();
  if (to.getDate() < from.getDate()) months--;
  if (months < 0) { years--; months += 12; }
  return { years, months };
}

function ageLabel({ years, months }: { years: number; months: number }) {
  return years < 1 ? `${months} mois` : `${years} ans`;
}

function getGeneration(year: number): { label: string; color: string } | null {
  if (year < 1928) return { label: "Génération de la guerre", color: "bg-stone-100 text-stone-500" };
  if (year < 1946) return { label: "Silent Generation", color: "bg-stone-100 text-stone-500" };
  if (year < 1965) return { label: "Baby-boomers",      color: "bg-orange-50 text-orange-600" };
  if (year < 1981) return { label: "Génération X",      color: "bg-blue-50 text-blue-600"    };
  if (year < 1997) return { label: "Millenials",        color: "bg-violet-50 text-violet-600" };
  if (year < 2013) return { label: "Génération Z",      color: "bg-emerald-50 text-emerald-600" };
  if (year < 2026) return { label: "Génération Alpha",      color: "bg-emerald-50 text-emerald-600" };
  return           { label: "Génération Beta",         color: "bg-pink-50 text-pink-700"    };
}

const now  = new Date();
const data = await persons.find({ active: true }).toArray();

const personsList = data
  .map((p) => {
    const dob = p.dateNaissance ? new Date(p.dateNaissance) : null;
    const dod = p.dateDeces     ? new Date(p.dateDeces)     : null;
    return {
      _id:          p._id!.toString(),
      prenom:       p.prenom,
      nom:          p.nom,
      email:        p.email ?? null,
      dateNaissance: p.dateNaissance ?? null,
      dateDeces:    p.dateDeces ?? null,
      generation:   dob ? getGeneration(dob.getFullYear()) : null,
      ageDeces:     dob && dod ? ageLabel(calcAge(dob, dod))  : null,
      ageAujourdhui: dob       ? ageLabel(calcAge(dob, now))  : null,
      anneesDeces:  dod ? dod.getFullYear() : null,
    };
  })
  .sort((a, b) => {
    if (!a.dateNaissance) return 1;
    if (!b.dateNaissance) return -1;
    return new Date(a.dateNaissance).getTime() - new Date(b.dateNaissance).getTime();
  });
---

<Baselayout title="Personnes">
  <div class="max-w-4xl mx-auto px-6 py-8 space-y-6">

    <!-- En-tête -->
    <div class="sticky top-14 z-10 bg-stone-50 pb-4 space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-semibold text-stone-800 tracking-tight">Personnes</h1>
        <p class="text-sm text-stone-500 mt-0.5">{personsList.length} personne{personsList.length > 1 ? 's' : ''} dans la liste</p>
      </div>
      <a href="/persons/add-with-relations"
        class="inline-flex items-center gap-2 px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium rounded-lg transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Ajouter
      </a>
    </div>

    <!-- Barre recherche + tri -->
    <div class="flex gap-3">
      <div class="relative flex-1">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
        </svg>
        <input
          id="search-input" type="text"
          placeholder="Rechercher par nom ou prénom…"
          class="w-full pl-9 pr-4 py-2.5 rounded-lg border border-stone-200 bg-white text-stone-900 placeholder-stone-400 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition"
        />
      </div>
      <button id="sort-toggle" data-order="asc"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-stone-200 bg-white text-stone-600 text-sm font-medium hover:bg-stone-50 transition-colors whitespace-nowrap">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"/>
        </svg>
        <span id="sort-label">A → Z</span>
      </button>
    </div>
  </div>
    <!-- Liste -->
    <div id="persons-list" class="space-y-2">
      {personsList.map((p) => (
       <div
  class="person-card bg-white border border-stone-200 rounded-xl px-4 py-3 sm:px-5 sm:py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 hover:border-stone-300 hover:shadow-sm transition group"
  data-nom={p.nom.toLowerCase()}
  data-prenom={p.prenom.toLowerCase()}
>
  <!-- Infos -->
  <div class="flex items-center gap-3 min-w-0 flex-1">

    <!-- Avatar -->
    <div class={`w-9 h-9 rounded-full flex items-center justify-center shrink-0 border ${
      p.dateDeces ? 'bg-stone-100 border-stone-200' : 'bg-amber-50 border-amber-100'
    }`}>
      <span class={`text-sm font-medium ${p.dateDeces ? 'text-stone-400' : 'text-amber-700'}`}>
        {p.prenom.charAt(0).toUpperCase()}{p.nom.charAt(0).toUpperCase()}
      </span>
    </div>

    <!-- Texte -->
    <div class="min-w-0 flex-1">

      <!-- Nom + génération -->
      <div class="flex flex-col items-start md:flex-row md:items-center gap-2 flex-wrap">
        <p class="text-sm font-medium text-stone-800 capitalize truncate">
          {p.prenom} {p.nom}
        </p>
        {p.generation && (
          <span class={`inline-flex items-center px-1.5 py-0.5 rounded-md text-xs font-medium shrink-0 ${p.generation.color}`}>
            {p.generation.label}
          </span>
        )}
      </div>

      <!-- Métadonnées -->
      <div class="flex items-center flex-wrap gap-x-3 gap-y-0.5 mt-0.5 text-xs text-stone-400">
        {p.dateNaissance && <span class="shrink-0">Né(e) le {formatDateFR(p.dateNaissance)}</span>}
        {p.dateDeces
          ? <span class="shrink-0">† {p.anneesDeces} · {p.ageDeces} · aurait {p.ageAujourdhui}</span>
          : p.ageAujourdhui && <span class="shrink-0">{p.ageAujourdhui}</span>
        }
        {p.email && !p.dateDeces && <span class="truncate max-w-[180px] sm:max-w-none">{p.email}</span>}
      </div>

    </div>
  </div>

  <!-- Actions -->
  <div class="flex justify-end items-center gap-1 shrink-0 sm:ml-4 sm:opacity-60 sm:group-hover:opacity-100 sm:transition-opacity border-t border-stone-100 pt-2 sm:border-0 sm:pt-0">
    <a href={`/persons/${p._id}`}
      class="p-2 rounded-lg text-stone-500 hover:text-stone-800 hover:bg-stone-100 transition-colors"
      title="Voir">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
      </svg>
    </a>
    <a href={`/tree/${p._id}`}
      class="p-2 rounded-lg text-stone-500 hover:text-amber-700 hover:bg-amber-50 transition-colors"
      title="Vue arbre">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h6M3 12h6M3 17h6M13 7l4 5-4 5M17 12H21"/>
      </svg>
    </a>
    <a href={`/persons/new?id=${p._id}`}
      class="p-2 rounded-lg text-stone-500 hover:text-stone-800 hover:bg-stone-100 transition-colors"
      title="Modifier">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 012.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-1.414a2 2 0 01.586-1.414z"/>
      </svg>
    </a>
    <div class="p-2 rounded-lg text-stone-500 hover:text-red-500 hover:bg-red-50 transition-colors" title="Supprimer">
      <DeleteButton type="person" id={p._id} />
    </div>
  </div>
</div>
      ))}
    </div>

    <!-- Aucun résultat -->
    <div id="no-results" class="hidden text-center py-12">
      <div class="w-12 h-12 rounded-full bg-stone-100 flex items-center justify-center mx-auto mb-3">
        <svg class="w-6 h-6 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
        </svg>
      </div>
      <p class="text-sm text-stone-400">Aucune personne trouvée</p>
    </div>

  </div>
</Baselayout>

<script>
  document.querySelectorAll(".delete-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id  = btn.getAttribute("data-id");
      const nom = btn.getAttribute("data-nom");
      if (!confirm(`Voulez-vous vraiment supprimer ${nom} ?`)) return;
      await fetch(`/api/persons/${id}`, { method: "DELETE" });
      window.location.reload();
    });
  });

  const searchInput = document.getElementById("search-input") as HTMLInputElement;
  const sortToggle  = document.getElementById("sort-toggle")  as HTMLButtonElement;
  const sortLabel   = document.getElementById("sort-label")   as HTMLSpanElement;
  const list        = document.getElementById("persons-list") as HTMLElement;
  const noResults   = document.getElementById("no-results")   as HTMLElement;

  function getCards() {
    return Array.from(list.querySelectorAll<HTMLElement>(".person-card"));
  }

  function applyFilterAndSort() {
    const query = searchInput.value.toLowerCase().trim();
    const order = sortToggle.dataset.order;
    const cards = getCards();

    cards.forEach((card) => {
      const match = (card.dataset.nom ?? "").includes(query) ||
                    (card.dataset.prenom ?? "").includes(query);
      card.style.display = match ? "" : "none";
    });

    const visible = cards.filter(c => c.style.display !== "none");
    visible.sort((a, b) => {
      const ka = (a.dataset.prenom ?? "") + (a.dataset.nom ?? "");
      const kb = (b.dataset.prenom ?? "") + (b.dataset.nom ?? "");
      return order === "asc" ? ka.localeCompare(kb, "fr") : kb.localeCompare(ka, "fr");
    });
    visible.forEach(card => list.appendChild(card));

    noResults.classList.toggle("hidden", visible.length > 0);
  }

  searchInput.addEventListener("input", applyFilterAndSort);

  sortToggle.addEventListener("click", () => {
    const isAsc = sortToggle.dataset.order === "asc";
    sortToggle.dataset.order = isAsc ? "desc" : "asc";
    sortLabel.textContent    = isAsc ? "Z → A" : "A → Z";
    applyFilterAndSort();
  });
</script>