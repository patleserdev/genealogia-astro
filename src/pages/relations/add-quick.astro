---
import { ObjectId } from "mongodb";
import Baselayout from "../../layouts/Baselayout.astro";
import { verifyToken } from "../../lib/auth.ts";
import { db, persons as personsCol, relations as relationsCol } from "../../lib/mongo";
import { formatFullName } from "../../utils/formatName.ts";

export const prerender = false;

const token = Astro.cookies.get('token')?.value
if (!token) return Astro.redirect('/login')

let user: any   = null

try {
  const payload = verifyToken(token)
  user   = await db.collection('users').findOne({ _id: new ObjectId(payload.userId) })
 
} catch {
  return Astro.redirect('/login')
}

const persons = await personsCol.find({ active: true }).toArray();
const allPersonsForCouples = await personsCol.find({}).toArray();
const coupleRelations = await relationsCol.find({ type: "CONJOINT" }).toArray();

function isMajeur(dateNaissance?: string): boolean {
  if (!dateNaissance) return true;
  const birth = new Date(dateNaissance);
  const majority = new Date(birth);
  majority.setFullYear(majority.getFullYear() + 18);
  return majority <= new Date();
}

const personsData = persons
  .map((p) => ({
    _id: p._id!.toString(),
    prenom: p.prenom,
    nom: p.nom,
    majeur: isMajeur(p.dateNaissance),
  }))
  .sort((a, b) => a.nom.localeCompare(b.nom, "fr"));

const coupleRelationsData = coupleRelations.map((r) => {
  const p1 = allPersonsForCouples.find((p) => p._id!.toString() === r.from.toString());
  const p2 = allPersonsForCouples.find((p) => p._id!.toString() === r.to.toString());
  return {
    _id: r._id!.toString(),
    fromId: r.from.toString(),
    toId: r.to.toString(),
    label: p1 && p2
      ? `${formatFullName(p1.prenom, p1.nom)} & ${formatFullName(p2.prenom, p2.nom)}`
      : r._id!.toString(),
  };
});
---

<Baselayout title="Connecter deux personnes">
  <div class="max-w-4xl mx-auto px-6 py-8">

    <!-- En-tête -->
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-semibold text-stone-800 tracking-tight">Connecter deux personnes</h1>
        <p class="text-sm text-stone-500 mt-0.5">Créez un lien de couple ou parent/enfant</p>
      </div>
      <a href="/relations"
        class="inline-flex items-center gap-2 text-sm text-stone-500 hover:text-stone-800 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Retour
      </a>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">

      <!-- Formulaire (2/3) -->
      <div class="lg:col-span-2 space-y-5">

        <!-- Personne A -->
        <div class="bg-white border border-stone-200 rounded-xl p-5">
          <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-3">
            Personne A
          </label>
          <div class="relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
            </svg>
            <input id="searchA" type="text" placeholder="Rechercher par nom…" autocomplete="off"
              class="w-full pl-9 pr-4 py-2.5 rounded-lg border border-stone-200 bg-stone-50 text-stone-900 placeholder-stone-400 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition "/>
          </div>
          <ul id="resultsA" class="hidden mt-1 border border-stone-200 rounded-xl bg-white shadow-md overflow-hidden max-h-48 overflow-y-auto divide-y divide-stone-100 capitalize"></ul>
          <input type="hidden" id="personA" />
          <p id="selectedA" class="hidden mt-2 text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2"></p>
        </div>

        <!-- Type de relation -->
        <div class="bg-white border border-stone-200 rounded-xl p-5">
          <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-3">
            Type de relation
          </label>
          <div class="grid grid-cols-3 gap-2">
            <button type="button" id="btnConjoint" data-type="CONJOINT"
              class="type-btn flex flex-col items-center gap-2 py-3 px-2 rounded-xl border-2 transition-all">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </div>
              <span class="text-xs font-semibold">Conjoint</span>
            </button>
            <button type="button" id="btnParent" data-type="PARENT"
              class="type-btn flex flex-col items-center gap-2 py-3 px-2 rounded-xl border-2 transition-all">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/>
                </svg>
              </div>
              <span class="text-xs font-semibold">Parent de</span>
            </button>
            <button type="button" id="btnEnfant" data-type="ENFANT"
              class="type-btn flex flex-col items-center gap-2 py-3 px-2 rounded-xl border-2 transition-all">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197"/>
                </svg>
              </div>
              <span class="text-xs font-semibold">Enfant de</span>
            </button>
          </div>
          <input type="hidden" id="relationType" value="CONJOINT" />
        </div>

        <!-- Personne B -->
        <div class="bg-white border border-stone-200 rounded-xl p-5">
          <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-3">
            Personne B
          </label>
          <div class="relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
            </svg>
            <input id="searchB" type="text" placeholder="Rechercher par nom…" autocomplete="off"
              class="w-full pl-9 pr-4 py-2.5 rounded-lg border border-stone-200 bg-stone-50 text-stone-900 placeholder-stone-400 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition"/>
          </div>
          <ul id="resultsB" class="hidden mt-1 border border-stone-200 rounded-xl bg-white shadow-md overflow-hidden max-h-48 overflow-y-auto divide-y divide-stone-100 capitalize"></ul>
          <input type="hidden" id="personB" />
          <p id="selectedB" class="hidden mt-2 text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2"></p>
        </div>

        <!-- Options CONJOINT -->
        <div id="optionsConjoint" class="bg-white border border-stone-200 rounded-xl p-5 space-y-4">
          <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider">
            Options couple
          </label>
          <div>
            <label class="block text-xs text-stone-500 mb-1">Statut</label>
            <select id="conjointStatus"
              class="w-full px-3 py-2 rounded-lg border border-stone-200 bg-stone-50 text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition">
              <option value="ACTIVE">En couple</option>
              <option value="DIVORCED">Divorcé</option>
            </select>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs text-stone-500 mb-1">Date début</label>
              <input type="date" id="dateDebut"
                class="w-full px-3 py-2 rounded-lg border border-stone-200 bg-stone-50 text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition"/>
            </div>
            <div>
              <label class="block text-xs text-stone-500 mb-1">Date fin</label>
              <input type="date" id="dateFin"
                class="w-full px-3 py-2 rounded-lg border border-stone-200 bg-stone-50 text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition"/>
            </div>
          </div>
        </div>

        <!-- Options PARENT -->
        <div id="optionsParent" class="hidden bg-white border border-stone-200 rounded-xl p-5 space-y-4">
          <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider">
            Options parent
          </label>
          <div>
            <label class="block text-xs text-stone-500 mb-1">Couple associé <span class="text-stone-400">(optionnel)</span></label>
            <select id="coupleRelationId"
              class="w-full px-3 py-2 rounded-lg border border-stone-200 bg-stone-50 text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition">
              <option value="">— Aucun couple —</option>
            </select>
          </div>
        </div>

      </div>

      <!-- Panneau récap (1/3) -->
      <div class="space-y-4">
        <div class="bg-white border border-stone-200 rounded-xl p-5 sticky top-20">
          <h2 class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-4">Récapitulatif</h2>

          <!-- Personnes sélectionnées -->
          <div class="space-y-3 mb-4">
            <div class="flex items-center gap-3">
              <div id="avatarA"
                class="w-9 h-9 rounded-full bg-stone-100 border border-stone-200 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs text-stone-400">Personne A</p>
                <p id="recapA" class="text-sm font-medium text-stone-400 italic">Non sélectionné</p>
              </div>
            </div>

            <div class="flex items-center justify-center">
              <div id="relationIcon" class="w-6 h-6 rounded-full bg-stone-100 flex items-center justify-center">
                <svg class="w-3.5 h-3.5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div id="avatarB"
                class="w-9 h-9 rounded-full bg-stone-100 border border-stone-200 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs text-stone-400">Personne B</p>
                <p id="recapB" class="text-sm font-medium text-stone-400 italic">Non sélectionné</p>
              </div>
            </div>
          </div>

          <!-- Message recap -->
          <div id="recap" class="hidden mb-4 text-xs bg-amber-50 border border-amber-200 text-amber-800 rounded-lg px-3 py-2"></div>

          <!-- Bouton -->
          <button id="btnSubmit" type="button" disabled
            class="w-full py-2.5 px-4 bg-amber-600 hover:bg-amber-700 disabled:opacity-40 disabled:cursor-not-allowed text-white text-sm font-medium rounded-lg transition-colors">
            Créer la relation
          </button>
        </div>
      </div>

    </div>
  </div>
</Baselayout>

<style>
  .type-btn {
    background: #fafaf9;
    color: #78716c;
    border-color: #e7e5e4;
  }
  .type-btn:hover {
    background: #f5f5f4;
    border-color: #a8a29e;
  }
  .type-btn.active {
    background: #fffbeb;
    color: #92400e;
    border-color: #d97706;
  }
  .type-btn.active div {
    background: #fef3c7;
    color: #b45309;
  }
  .type-btn div {
    background: #f5f5f4;
    color: #a8a29e;
    transition: all 0.15s;
  }
</style>

<script define:vars={{ personsData, coupleRelationsData }}>
  let selectedA    = null;
  let selectedB    = null;
  let relationType = "CONJOINT";

  // ── Recherche ─────────────────────────────────────────────────────────
  function setupSearch(inputId, resultsId, selectedLabelId, onSelect) {
    const input   = document.getElementById(inputId);
    const results = document.getElementById(resultsId);

    input.addEventListener("input", () => {
      const q = input.value.toLowerCase().trim();
      results.innerHTML = "";
      if (!q) { results.classList.add("hidden"); return; }

      const matches = personsData
        .filter(p => `${p.prenom} ${p.nom}`.toLowerCase().includes(q))
        .slice(0, 8);

      if (!matches.length) { results.classList.add("hidden"); return; }

      matches.forEach(p => {
        const li = document.createElement("li");
        li.className = "px-4 py-2.5 hover:bg-amber-50 cursor-pointer text-sm text-stone-700 flex items-center gap-3";
        li.innerHTML = `
          <span class="w-7 h-7 rounded-full bg-amber-50 border border-amber-100 flex items-center justify-center text-xs font-medium text-amber-700 shrink-0">
            ${p.prenom.charAt(0)}${p.nom.charAt(0)}
          </span>
          <span>${p.prenom} ${p.nom}</span>`;
        li.addEventListener("click", () => {
          onSelect(p);
          input.value = `${p.prenom} ${p.nom}`;
          results.classList.add("hidden");
        });
        results.appendChild(li);
      });
      results.classList.remove("hidden");
    });

    document.addEventListener("click", (e) => {
      if (!input.contains(e.target) && !results.contains(e.target))
        results.classList.add("hidden");
    });
  }

  function setAvatar(avatarId, recapId, person) {
    const avatar = document.getElementById(avatarId);
    const recap  = document.getElementById(recapId);
    if (person) {
      avatar.innerHTML = `<span class="text-xs font-semibold text-amber-700">${person.prenom.charAt(0)}${person.nom.charAt(0)}</span>`;
      avatar.className = "w-9 h-9 rounded-full bg-amber-50 border border-amber-200 flex items-center justify-center shrink-0";
      recap.textContent = `${person.prenom} ${person.nom}`;
      recap.className = "text-sm font-medium text-stone-800";
    }
  }

  setupSearch("searchA", "resultsA", "selectedA", (p) => {
    selectedA = p;
    document.getElementById("selectedA").textContent = `✓ ${p.prenom} ${p.nom}`;
    document.getElementById("selectedA").classList.remove("hidden");
    setAvatar("avatarA", "recapA", p);
    updateCoupleSuggestions();
    updateRecap();
    updateSubmit();
  });

  setupSearch("searchB", "resultsB", "selectedB", (p) => {
    selectedB = p;
    document.getElementById("selectedB").textContent = `✓ ${p.prenom} ${p.nom}`;
    document.getElementById("selectedB").classList.remove("hidden");
    setAvatar("avatarB", "recapB", p);
    updateCoupleSuggestions();
    updateRecap();
    updateSubmit();
  });

  // ── Type buttons ──────────────────────────────────────────────────────
  const typeBtns = document.querySelectorAll(".type-btn");

  // Init : activer CONJOINT
  document.getElementById("btnConjoint").classList.add("active");

  typeBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      relationType = btn.dataset.type;
      document.getElementById("relationType").value = relationType;

      typeBtns.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");

      document.getElementById("optionsConjoint").classList.toggle("hidden", relationType !== "CONJOINT");
      document.getElementById("optionsParent").classList.toggle("hidden",   relationType === "CONJOINT");

      updateRelationIcon();
      updateCoupleSuggestions();
      updateRecap();
      updateSubmit();
    });
  });

  function updateRelationIcon() {
    const icon = document.getElementById("relationIcon");
    if (relationType === "CONJOINT") {
      icon.innerHTML = `<svg class="w-3.5 h-3.5 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`;
      icon.className = "w-6 h-6 rounded-full bg-pink-50 flex items-center justify-center";
    } else {
      icon.innerHTML = `<svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>`;
      icon.className = "w-6 h-6 rounded-full bg-amber-50 flex items-center justify-center";
    }
  }

  // ── Suggestions couples ───────────────────────────────────────────────
  function updateCoupleSuggestions() {
    const select = document.getElementById("coupleRelationId");
    select.innerHTML = '<option value="">— Aucun couple —</option>';
    let filtered = coupleRelationsData;
    if (selectedA || selectedB) {
      const ids = [selectedA?._id, selectedB?._id].filter(Boolean);
      filtered = filtered.filter(c => ids.some(id => c.fromId === id || c.toId === id));
    }
    filtered.forEach(c => {
      const opt = document.createElement("option");
      opt.value = c._id;
      opt.textContent = c.label;
      select.appendChild(opt);
    });
    if (selectedA && selectedB) {
      const exact = filtered.find(c =>
        (c.fromId === selectedA._id && c.toId === selectedB._id) ||
        (c.fromId === selectedB._id && c.toId === selectedA._id)
      );
      if (exact) select.value = exact._id;
      else if (filtered.length === 1) select.value = filtered[0]._id;
    } else if (filtered.length === 1) {
      select.value = filtered[0]._id;
    }
  }

  // ── Récap ─────────────────────────────────────────────────────────────
  function updateRecap() {
    const recap = document.getElementById("recap");
    if (!selectedA || !selectedB) { recap.classList.add("hidden"); return; }
    if (selectedA._id === selectedB._id) {
      recap.textContent = "Vous ne pouvez pas relier une personne à elle-même.";
      recap.className = "mb-4 text-xs bg-red-50 border border-red-200 text-red-700 rounded-lg px-3 py-2";
      recap.classList.remove("hidden");
      return;
    }
    const nameA  = `${selectedA.prenom} ${selectedA.nom}`;
    const nameB  = `${selectedB.prenom} ${selectedB.nom}`;
    const texts  = {
      CONJOINT: `${nameA} et ${nameB} seront en couple.`,
      PARENT:   `${nameA} sera parent de ${nameB}.`,
      ENFANT:   `${nameA} sera enfant de ${nameB}.`,
    };
    recap.textContent = texts[relationType];
    recap.className   = "mb-4 text-xs bg-amber-50 border border-amber-200 text-amber-800 rounded-lg px-3 py-2";
    recap.classList.remove("hidden");
  }

  function updateSubmit() {
    document.getElementById("btnSubmit").disabled =
      !selectedA || !selectedB || selectedA._id === selectedB._id;
  }

  // ── Submit ────────────────────────────────────────────────────────────
  document.getElementById("btnSubmit").addEventListener("click", async () => {
    if (!selectedA || !selectedB || selectedA._id === selectedB._id) return;

    let payload = {};
    if (relationType === "CONJOINT") {
      payload = {
        type: "CONJOINT",
        from: selectedA._id,
        to: selectedB._id,
        status: document.getElementById("conjointStatus").value,
        dateDebut: document.getElementById("dateDebut").value || null,
        dateFin:   document.getElementById("dateFin").value   || null,
      };
    } else {
      const coupleRelationId = document.getElementById("coupleRelationId").value;
      payload = {
        type: "PARENT",
        from: relationType === "PARENT" ? selectedA._id : selectedB._id,
        to:   relationType === "PARENT" ? selectedB._id : selectedA._id,
        ...(coupleRelationId ? { coupleRelationId } : {}),
      };
    }

    const btn = document.getElementById("btnSubmit");
    btn.disabled    = true;
    btn.textContent = "Création en cours…";

    const res = await fetch("/api/relations", {
      method:  "POST",
      headers: { "Content-Type": "application/json" },
      body:    JSON.stringify(payload),
    });

    if (!res.ok) {
      const err = document.getElementById("recap");
      err.textContent = "Erreur lors de la création.";
      err.className   = "mb-4 text-xs bg-red-50 border border-red-200 text-red-700 rounded-lg px-3 py-2";
      err.classList.remove("hidden");
      btn.disabled    = false;
      btn.textContent = "Créer la relation";
      return;
    }

    window.location.href = "/relations";
  });

  // Init icône
  updateRelationIcon();
</script>