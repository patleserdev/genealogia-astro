---
import Baselayout from "../../layouts/Baselayout.astro";
import { db, persons, relations } from "../../lib/mongo";
import { ObjectId } from "mongodb";
import { formatFullName } from "../../utils/formatName.ts";
import { formatDateFR } from "../../utils/formatDate.ts";
import { verifyToken } from "../../lib/auth.ts";

export const prerender = false;

const token = Astro.cookies.get('token')?.value
if (!token) return Astro.redirect('/login')

let user: any   = null

try {
  const payload = verifyToken(token)
  user   = await db.collection('users').findOne({ _id: new ObjectId(payload.userId) })
 
} catch {
  return Astro.redirect('/login')
}

const { id } = Astro.params;
const personId = new ObjectId(id);
const returnUrl  = Astro.url.searchParams.get("returnUrl") || "/persons";

// 1. Récupérer la personne
const person = await persons.findOne({ _id: personId });
if (!person) throw new Error("Personne non trouvée");

// 2. Récupérer toutes les relations CONJOINT de cette personne
const allSpouseRels = await relations
  .find({
    type: "CONJOINT",
    $or: [{ from: personId }, { to: personId }],
  })
  .toArray();

// 3. Récupérer toutes les relations PARENT où cette personne est enfant
const parentRels = await relations
  .find({
    type: "PARENT",
    to: personId,
  })
  .toArray();

// 4. Récupérer toutes les relations PARENT où cette personne est parent
const myChildRels = await relations
  .find({
    type: "PARENT",
    from: personId,
  })
  .toArray();

// 5. Construire la liste des conjoints/ex-conjoints avec enfants
const spouseEntries = [];

for (const rel of allSpouseRels) {
  const fromId =
    typeof rel.from === "string" ? new ObjectId(rel.from) : rel.from;
  const toId = typeof rel.to === "string" ? new ObjectId(rel.to) : rel.to;

  const spouseId = fromId.equals(personId) ? toId : fromId;
  const spousePerson = await persons.findOne({ _id: spouseId });

  // Enfants liés à ce couple
  const coupleId =
    typeof rel._id === "string" ? new ObjectId(rel._id) : rel._id;
  const childrenRels = await relations
    .find({
      type: "PARENT",
      coupleRelationId: coupleId,
    })
    .toArray();

  const childrenIds = childrenRels.map((r) =>
    typeof r.to === "string" ? new ObjectId(r.to) : r.to,
  );

  const children =
    childrenIds.length > 0
      ? await persons.find({ _id: { $in: childrenIds } }).toArray()
      : [];

  spouseEntries.push({
    relId: rel._id.toString(),
    spousePerson,
    status: rel.status ?? "ACTIVE",
    dateDebut: rel.dateDebut,
    dateFin: rel.dateFin,
    children,
  });
}

// 6. Enfants sans couple associé
const orphanChildRels = myChildRels.filter((r) => !r.coupleRelationId);
const orphanChildren =
  orphanChildRels.length > 0
    ? await persons
        .find({
          _id: {
            $in: orphanChildRels.map((r) =>
              typeof r.to === "string" ? new ObjectId(r.to) : r.to,
            ),
          },
        })
        .toArray()
    : [];

// 7. Parents directs (relations PARENT où cette personne est enfant)

const parentIds = parentRels.map((r) =>
  typeof r.from === "string" ? new ObjectId(r.from) : r.from,
);

// Récupérer aussi les seconds parents via coupleRelationId
for (const rel of parentRels) {
  if (rel.coupleRelationId) {
    const coupleRel = await relations.findOne({ _id: rel.coupleRelationId });
    if (coupleRel) {
      const fromId =
        typeof coupleRel.from === "string"
          ? new ObjectId(coupleRel.from)
          : coupleRel.from;
      const toId =
        typeof coupleRel.to === "string"
          ? new ObjectId(coupleRel.to)
          : coupleRel.to;
      // Ajouter l'autre parent s'il n'est pas déjà dans la liste
      const otherParentId = fromId.equals(parentIds[0]) ? toId : fromId;
      if (!parentIds.some((id) => id.equals(otherParentId))) {
        parentIds.push(otherParentId);
      }
    }
  }
}

const parentObjs =
  parentIds.length > 0
    ? await persons.find({ _id: { $in: parentIds } }).toArray()
    : [];

// 8. Frères et sœurs
const siblings: any[] = [];

for (const rel of parentRels) {
  if (rel.coupleRelationId) {
    // Tous les enfants du même couple
    const siblingRels = await relations
      .find({
        type: "PARENT",
        coupleRelationId: rel.coupleRelationId,
        to: { $ne: personId }, // exclure la personne elle-même
      })
      .toArray();

    for (const sibRel of siblingRels) {
      const sibId =
        typeof sibRel.to === "string" ? new ObjectId(sibRel.to) : sibRel.to;
      if (!siblings.some((s) => s._id.equals(sibId))) {
        const sibPerson = await persons.findOne({ _id: sibId });
        if (sibPerson) siblings.push(sibPerson);
      }
    }
  }
}

// ── Timeline ─────────────────────────────────────────────────────────────
interface TimelineEvent {
  date: string;
  type: 'birth' | 'death' | 'union' | 'separation';
  label: string;
  personName: string;
  personId: string;
  level: 'parent' | 'self' | 'child' | 'grandchild'| 'sibling';
}

const timelineEvents: TimelineEvent[] = [];

// Helpers
function addBirth(p: any, level: TimelineEvent['level']) {
  if (p?.dateNaissance) timelineEvents.push({
    date: new Date(p.dateNaissance).toISOString(),
    type: 'birth',
    label: 'Naissance',
    personName: formatFullName(p.prenom, p.nom),
    personId: p._id.toString(),
    level,
  });
}

function addDeath(p: any, level: TimelineEvent['level']) {
  if (p?.dateDeces) timelineEvents.push({
    date: new Date(p.dateDeces).toISOString(),
    type: 'death',
    label: 'Décès',
    personName: formatFullName(p.prenom, p.nom),
    personId: p._id.toString(),
    level,
  });
}

// Soi-même
addBirth(person, 'self');
addDeath(person, 'self');

// Parents
for (const p of parentObjs) { addBirth(p, 'parent'); addDeath(p, 'parent'); }

// Frères & sœurs
for (const s of siblings) { addBirth(s, 'sibling'); addDeath(s, 'sibling'); }
// Unions de la personne
for (const entry of spouseEntries) {
  if (entry.dateDebut) timelineEvents.push({
    date: new Date(entry.dateDebut).toISOString(),

    type: 'union',
    label: entry.status === 'ACTIVE' ? 'Mariage / union' : 'Union',
    personName: entry.spousePerson
      ? formatFullName(entry.spousePerson.prenom, entry.spousePerson.nom)
      : 'Inconnu(e)',
    personId: entry.spousePerson?._id?.toString() ?? '',
    level: 'self',
  });
  if (entry.dateFin) timelineEvents.push({
    date: new Date(entry.dateFin).toISOString(),
    type: 'separation',
    label: 'Séparation',
    personName: entry.spousePerson
      ? formatFullName(entry.spousePerson.prenom, entry.spousePerson.nom)
      : 'Inconnu(e)',
    personId: entry.spousePerson?._id?.toString() ?? '',
    level: 'self',
  });

  // Enfants de ce couple
  for (const c of entry.children) { addBirth(c, 'child'); addDeath(c, 'child'); }
}

// Enfants orphelins
for (const c of orphanChildren) { addBirth(c, 'child'); addDeath(c, 'child'); }

// Petits-enfants (enfants des enfants)
const allChildren = [
  ...spouseEntries.flatMap(e => e.children),
  ...orphanChildren,
];
for (const child of allChildren) {
  const grandchildRels = await relations.find({
    type: 'PARENT',
    from: child._id,
  }).toArray();
  const grandchildIds = grandchildRels.map(r =>
    typeof r.to === 'string' ? new ObjectId(r.to) : r.to
  );
  if (grandchildIds.length > 0) {
    const grandchildren = await persons.find({ _id: { $in: grandchildIds } }).toArray();
    for (const gc of grandchildren) { addBirth(gc, 'grandchild'); addDeath(gc, 'grandchild'); }
  }
}

const personBirthDate = person.dateNaissance ? new Date(person.dateNaissance) : null;


// Tri chronologique
timelineEvents.sort((a, b) =>
  new Date(a.date).getTime() - new Date(b.date).getTime()
);

const filteredTimeline = personBirthDate
  ? timelineEvents.filter(ev => new Date(ev.date) >= personBirthDate)
  : timelineEvents;
---

<Baselayout title={`${formatFullName(person.prenom, person.nom)}`}>
  <div class="max-w-4xl mx-auto px-6 py-8 space-y-6">

    <!-- En-tête -->
    <div class="flex items-center justify-between">
      <a href={returnUrl}
        class="inline-flex items-center gap-2 text-sm text-stone-500 hover:text-stone-800 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Retour
      </a>
      <div class="flex items-center gap-2">
        <a href={`/tree/${person._id}`}
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-stone-200 text-stone-600 hover:border-amber-300 hover:text-amber-700 text-sm font-medium transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M3 7h6M3 12h6M3 17h6M13 7l4 5-4 5M17 12H21"/>
          </svg>
          Vue arbre
        </a>
        <a href={`/persons/new?id=${person._id}&returnUrl=${encodeURIComponent(Astro.url.pathname)}`}
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 012.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-1.414a2 2 0 01.586-1.414z"/>
          </svg>
          Modifier
        </a>
      </div>
    </div>

    <!-- Carte identité -->
    <div class="bg-white border border-stone-200 rounded-xl p-6">
      <div class="flex items-start gap-5">

        <!-- Avatar -->
        <div class="w-16 h-16 rounded-full bg-amber-50 border-2 border-amber-200 flex items-center justify-center shrink-0">
          <span class="text-xl font-semibold text-amber-700">
            {person.prenom.charAt(0).toUpperCase()}{person.nom.charAt(0).toUpperCase()}
          </span>
        </div>

        <!-- Infos -->
        <div class="flex-1 min-w-0">
          <h1 class="text-2xl font-semibold text-stone-800 tracking-tight">
            {formatFullName(person.prenom, person.nom)}
          </h1>

          <div class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div>
              <p class="text-xs text-stone-400 mb-0.5">Naissance</p>
              <p class="text-sm font-medium text-stone-800">
                {formatDateFR(person.dateNaissance) ?? '—'}
              </p>
            </div>
            {person.dateDeces && (
              <div>
                <p class="text-xs text-stone-400 mb-0.5">Décès</p>
                <p class="text-sm font-medium text-stone-800">{formatDateFR(person.dateDeces)}</p>
              </div>
            )}
            <div>
              <p class="text-xs text-stone-400 mb-0.5">Sexe</p>
              <p class="text-sm font-medium text-stone-800">
                {person.sexe === 'M' ? 'Homme' : person.sexe === 'F' ? 'Femme' : person.sexe ?? '—'}
              </p>
            </div>
            <div>
              <p class="text-xs text-stone-400 mb-0.5">Email</p>
              <p class="text-sm font-medium text-stone-800 truncate">{person.email ?? '—'}</p>
            </div>
          </div>

          {person.notes && (
            <p class="mt-3 text-sm text-stone-500 italic border-t border-stone-100 pt-3">
              {person.notes}
            </p>
          )}
        </div>
      </div>
    </div>

    <!-- Grille relations -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

      <!-- Parents -->
      <div class="bg-white border border-stone-200 rounded-xl p-5">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-6 h-6 rounded-md bg-amber-50 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/>
            </svg>
          </div>
          <h3 class="text-xs font-semibold text-stone-500 uppercase tracking-wider">
            Parents
          </h3>
          <span class="ml-auto text-xs text-stone-400">{parentObjs.length}</span>
        </div>

        {parentObjs.length > 0 ? (
          <ul class="space-y-2">
            {parentObjs.map(p => (
              <li>
                <a href={`/persons/${p._id}`}
                  class="flex items-center gap-2.5 group">
                  <div class="w-7 h-7 rounded-full bg-stone-100 flex items-center justify-center shrink-0 text-xs font-medium text-stone-600 group-hover:bg-amber-50 group-hover:text-amber-700 transition-colors">
                    {p.prenom.charAt(0)}{p.nom.charAt(0)}
                  </div>
                  <span class="text-sm text-stone-700 group-hover:text-amber-700 transition-colors">
                    {formatFullName(p.prenom, p.nom)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-stone-400">Aucun parent enregistré</p>
        )}
      </div>

      <!-- Frères & Sœurs -->
      <div class="bg-white border border-stone-200 rounded-xl p-5">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-6 h-6 rounded-md bg-stone-100 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197"/>
            </svg>
          </div>
          <h3 class="text-xs font-semibold text-stone-500 uppercase tracking-wider">
            Frères & Sœurs
          </h3>
          <span class="ml-auto text-xs text-stone-400">{siblings.length}</span>
        </div>

        {siblings.length > 0 ? (
          <ul class="space-y-2">
            {siblings.map(s => (
              <li>
                <a href={`/persons/${s._id}`}
                  class="flex items-center gap-2.5 group">
                  <div class="w-7 h-7 rounded-full bg-stone-100 flex items-center justify-center shrink-0 text-xs font-medium text-stone-600 group-hover:bg-amber-50 group-hover:text-amber-700 transition-colors">
                    {s.prenom.charAt(0)}{s.nom.charAt(0)}
                  </div>
                  <div>
                    <span class="text-sm text-stone-700 group-hover:text-amber-700 transition-colors block">
                      {formatFullName(s.prenom, s.nom)}
                    </span>
                    {s.dateNaissance && (
                      <span class="text-xs text-stone-400">{formatDateFR(s.dateNaissance)}</span>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-stone-400">Aucun frère ou sœur enregistré</p>
        )}
      </div>

      <!-- Relations & Enfants -->
      <div class="bg-white border border-stone-200 rounded-xl p-5">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-6 h-6 rounded-md bg-pink-50 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
          </div>
          <h3 class="text-xs font-semibold text-stone-500 uppercase tracking-wider">
            Relations & Enfants
          </h3>
          <span class="ml-auto text-xs text-stone-400">{spouseEntries.length}</span>
        </div>

        {spouseEntries.length > 0 ? (
          <div class="space-y-3">
            {spouseEntries.map(entry => (
              <div class={`rounded-xl p-3 border ${
                entry.status === 'ACTIVE'
                  ? 'border-green-200 bg-green-50'
                  : 'border-stone-200 bg-stone-50'
              }`}>
                <!-- Conjoint -->
                <div class="flex items-center gap-2 mb-2">
                  <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${
                    entry.status === 'ACTIVE'
                      ? 'bg-green-100 text-green-700'
                      : 'bg-stone-200 text-stone-500'
                  }`}>
                    {entry.status === 'ACTIVE' ? 'Conjoint(e)' : 'Ex-conjoint(e)'}
                  </span>
                  {entry.spousePerson ? (
                    <a href={`/persons/${entry.spousePerson._id}`}
                      class="text-sm font-medium text-stone-800 hover:text-amber-700 transition-colors">
                      {formatFullName(entry.spousePerson.prenom, entry.spousePerson.nom)}
                    </a>
                  ) : (
                    <span class="text-sm text-stone-400 italic">Personne supprimée</span>
                  )}
                </div>

                {(entry.dateDebut || entry.dateFin) && (
                  <p class="text-xs text-stone-400 mb-2">
                    {entry.dateDebut && <>Depuis le {formatDateFR(entry.dateDebut)}</>}
                    {entry.dateFin   && <> — {formatDateFR(entry.dateFin)}</>}
                  </p>
                )}

                {entry.children.length > 0 ? (
                  <div>
                    <p class="text-xs font-medium text-stone-400 uppercase tracking-wide mb-1.5">
                      Enfants · {entry.children.length}
                    </p>
                    <ul class="space-y-1">
                      {entry.children.map(c => (
                        <li class="flex items-center gap-1.5">
                          <span class="text-stone-300">↳</span>
                          <a href={`/persons/${c._id}`}
                            class="text-sm text-stone-700 hover:text-amber-700 transition-colors">
                            {formatFullName(c.prenom, c.nom)}
                          </a>
                          {c.dateNaissance && (
                            <span class="text-xs text-stone-400 ml-auto">{c.dateNaissance}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                ) : (
                  <p class="text-xs text-stone-400 italic">Aucun enfant commun</p>
                )}
              </div>
            ))}
          </div>
        ) : (
          <p class="text-sm text-stone-400">Aucune relation enregistrée</p>
        )}
      </div>

      <!-- Enfants sans couple associé -->
      {orphanChildren.length > 0 && (
        <div class="bg-white border border-stone-200 rounded-xl p-5">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-6 h-6 rounded-md bg-amber-50 flex items-center justify-center">
              <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197"/>
              </svg>
            </div>
            <h3 class="text-xs font-semibold text-stone-500 uppercase tracking-wider">
              Enfants sans relation associée
            </h3>
            <span class="ml-auto text-xs text-stone-400">{orphanChildren.length}</span>
          </div>
          <ul class="space-y-2">
            {orphanChildren.map(c => (
              <li>
                <a href={`/persons/${c._id}`}
                  class="flex items-center gap-2.5 group">
                  <div class="w-7 h-7 rounded-full bg-stone-100 flex items-center justify-center shrink-0 text-xs font-medium text-stone-600 group-hover:bg-amber-50 group-hover:text-amber-700 transition-colors">
                    {c.prenom.charAt(0)}{c.nom.charAt(0)}
                  </div>
                  <div>
                    <span class="text-sm text-stone-700 group-hover:text-amber-700 transition-colors block">
                      {formatFullName(c.prenom, c.nom)}
                    </span>
                    {c.dateNaissance && (
                      <span class="text-xs text-stone-400">{formatDateFR(c.dateNaissance)}</span>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

    </div>
<!-- Timeline -->
<!-- Timeline -->
{filteredTimeline.length > 0 && (
  <div class="bg-white border border-stone-200 rounded-xl p-6">

    <div class="flex items-center gap-2 mb-4">
      <div class="w-6 h-6 rounded-md bg-stone-100 flex items-center justify-center">
        <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <h3 class="text-xs font-semibold text-stone-500 uppercase tracking-wider">Timeline familiale</h3>
      <span class="ml-auto text-xs text-stone-400" id="tl-count">{filteredTimeline.length} événements</span>
    </div>

    <!-- Filtres niveau (multi-sélection) -->
<div class="flex flex-wrap gap-2 mb-6">
  {[
    { key: 'all',        label: 'Tous',            color: 'bg-stone-800 text-white border border-stone-800'              },
    { key: 'parent',     label: 'Parents',         color: 'bg-amber-50 text-amber-700 border border-amber-200'          },
    { key: 'self',       label: 'Moi',             color: 'bg-stone-100 text-stone-700 border border-stone-300'         },
    { key: 'sibling',    label: 'Frères & sœurs',  color: 'bg-teal-50 text-teal-700 border border-teal-200'             },
    { key: 'child',      label: 'Enfants',         color: 'bg-blue-50 text-blue-700 border border-blue-200'             },
    { key: 'grandchild', label: 'Petits-enfants',  color: 'bg-violet-50 text-violet-700 border border-violet-200'       },
  ].map(f => (
    <button data-filter={f.key}
      class={`tl-filter px-3 py-1 rounded-full text-xs font-medium transition-all border ${f.color}`}>
      {f.label}
    </button>
  ))}
</div>

    <div class="relative">
      <div class="absolute left-[7px] top-0 bottom-0 w-px bg-stone-100"></div>

      <ul class="space-y-5" id="tl-list">
        {filteredTimeline.map(ev => {
          const icons = {
            birth:      { bg: 'bg-emerald-50',  border: 'border-emerald-200', dot: 'bg-emerald-400', text: 'text-emerald-700', icon: '✦' },
            death:      { bg: 'bg-stone-50',     border: 'border-stone-200',  dot: 'bg-stone-400',   text: 'text-stone-500',   icon: '†' },
            union:      { bg: 'bg-pink-50',      border: 'border-pink-200',   dot: 'bg-pink-400',    text: 'text-pink-700',    icon: '♥' },
            separation: { bg: 'bg-orange-50',    border: 'border-orange-200', dot: 'bg-orange-400',  text: 'text-orange-700',  icon: '✂' },
          };
          const levelLabels = {
  parent:     { label: 'Parent',          color: 'bg-amber-50 text-amber-700'    },
  self:       { label: 'Moi',             color: 'bg-stone-800 text-stone-100'   },
  sibling:    { label: 'Frère / Sœur',   color: 'bg-teal-50 text-teal-700'      },
  child:      { label: 'Enfant',          color: 'bg-blue-50 text-blue-700'      },
  grandchild: { label: 'Petit-enfant',    color: 'bg-violet-50 text-violet-700'  },
};
          const s = icons[ev.type];
          const l = levelLabels[ev.level];

          return (
            <li class="tl-item flex gap-4 pl-1" data-level={ev.level}>
              <div class="relative flex-shrink-0 mt-1">
                <div class={`w-3.5 h-3.5 rounded-full border-2 border-white ${s.dot} shadow-sm z-10 relative`}></div>
              </div>
              <div class={`flex-1 rounded-lg border px-4 py-3 ${s.bg} ${s.border}`}>
                <div class="flex items-start justify-between gap-2 flex-wrap">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class={`text-xs font-semibold ${s.text}`}>{s.icon} {ev.label}</span>
                    <span class={`text-xs px-1.5 py-0.5 rounded-full font-medium ${l.color}`}>{l.label}</span>
                  </div>
                  <span class="text-xs text-stone-400 font-mono shrink-0">{formatDateFR(ev.date)}</span>
                </div>
                <a href={`/persons/${ev.personId}`}
                  class="mt-1 block text-sm font-medium text-stone-700 hover:text-amber-700 transition-colors">
                  {ev.personName}
                </a>
              </div>
            </li>
          );
        })}
      </ul>

      <!-- Aucun résultat -->
      <p id="tl-empty" class="hidden text-sm text-stone-400 text-center py-6">
        Aucun événement pour ce filtre
      </p>
    </div>
  </div>
)}

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.tl-filter');
  const items      = document.querySelectorAll<HTMLElement>('.tl-item');
  const empty      = document.getElementById('tl-empty')!;
  const count      = document.getElementById('tl-count')!;

  // Styles actif / inactif par filtre
  const activeStyles: Record<string, string> = {
    all:        'bg-stone-800 text-white border-stone-800',
    parent:     'bg-amber-100 text-amber-800 border-amber-300',
    self:       'bg-stone-200 text-stone-800 border-stone-400',
    sibling:    'bg-teal-100 text-teal-800 border-teal-300',
    child:      'bg-blue-100 text-blue-800 border-blue-300',
    grandchild: 'bg-violet-100 text-violet-800 border-violet-300',
  };
  const inactiveStyles: Record<string, string> = {
    all:        'bg-white text-stone-400 border-stone-200',
    parent:     'bg-white text-stone-400 border-stone-200',
    self:       'bg-white text-stone-400 border-stone-200',
    sibling:    'bg-white text-stone-400 border-stone-200',
    child:      'bg-white text-stone-400 border-stone-200',
    grandchild: 'bg-white text-stone-400 border-stone-200',
  };

  const selected = new Set<string>();

  function setBtn(btn: HTMLButtonElement, isActive: boolean) {
    const key = btn.dataset.filter!;
    const add = isActive ? activeStyles[key] : inactiveStyles[key];
    const rem = isActive ? inactiveStyles[key] : activeStyles[key];
    rem.split(' ').forEach(c => btn.classList.remove(c));
    add.split(' ').forEach(c => btn.classList.add(c));
  }

  function applyFilters() {
    const showAll = selected.size === 0 || selected.has('all');

    filterBtns.forEach(btn => {
      const key = btn.dataset.filter!;
      const isActive = showAll
        ? key === 'all'
        : selected.has(key) && key !== 'all';
      setBtn(btn, isActive);
    });

    let visible = 0;
    items.forEach(item => {
      const show = showAll || selected.has(item.dataset.level!);
      item.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    empty.classList.toggle('hidden', visible > 0);
    count.textContent = `${visible} événement${visible > 1 ? 's' : ''}`;
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.filter!;
      if (key === 'all') {
        selected.clear();
      } else {
        selected.delete('all');
        if (selected.has(key)) selected.delete(key);
        else selected.add(key);
      }
      applyFilters();
    });
  });

  applyFilters();
</script>
    
  </div>
</Baselayout>