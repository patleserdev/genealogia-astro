---
import Baselayout from "../layouts/Baselayout.astro";
import { persons as personsCol, relations as relationsCol } from "../lib/mongo";
import { formatFullName } from "../utils/formatName.ts";

export const prerender = false;

const persons = await personsCol.find({ active: true }).toArray();
const coupleRelations = await relationsCol.find({ type: "CONJOINT" }).toArray();

function isMajeur(dateNaissance?: string): boolean {
  if (!dateNaissance) return true;
  const birth = new Date(dateNaissance);
  const majority = new Date(birth);
  majority.setFullYear(majority.getFullYear() + 18);
  return majority <= new Date();
}

const personsData = persons
  .map((p) => ({
    _id: p._id!.toString(),
    prenom: p.prenom,
    nom: p.nom,
    majeur: isMajeur(p.dateNaissance),
  }))
  .sort((a, b) => a.nom.localeCompare(b.nom, "fr"));

const coupleRelationsData = coupleRelations.map((r) => {
  const p1 = personsData.find((p) => p._id === r.from.toString());
  const p2 = personsData.find((p) => p._id === r.to.toString());
  return {
    _id: r._id!.toString(),
    fromId: r.from.toString(),
    toId: r.to.toString(),
    label: p1 && p2
      ? `${formatFullName(p1.prenom, p1.nom)} & ${formatFullName(p2.prenom, p2.nom)}`
      : r._id!.toString(),
  };
});
---

<Baselayout title="Ajouter une personne">
  <div class="max-w-2xl mx-auto space-y-6">
    <h2 class="text-2xl font-bold text-gray-800">👤 Nouvelle personne & relations</h2>

    <!-- PARTIE 1 : Infos personne -->
    <div class="bg-white rounded-2xl shadow-md border p-6 space-y-4">
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Informations</h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1">Prénom</label>
          <input type="text" id="prenom" class="w-full rounded-lg border-gray-300" placeholder="Prénom" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1">Nom</label>
          <input type="text" id="nom" class="w-full rounded-lg border-gray-300" placeholder="Nom" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1">Date de naissance</label>
          <input type="date" id="dateNaissance" class="w-full rounded-lg border-gray-300" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1">Date de décès</label>
          <input type="date" id="dateDeces" class="w-full rounded-lg border-gray-300" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1">Sexe</label>
          <select id="sexe" class="w-full rounded-lg border-gray-300">
            <option value="">— Non renseigné —</option>
            <option value="M">Homme</option>
            <option value="F">Femme</option>
            <option value="Autre">Autre</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-600 mb-1">Email</label>
        <input type="email" id="email" class="w-full rounded-lg border-gray-300" placeholder="email@exemple.com" />
      </div>
    </div>

    <!-- PARTIE 2 : Relations -->
    <div class="bg-white rounded-2xl shadow-md border p-6 space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Relations</h3>
        <button type="button" id="btnAddRelation"
          class="text-sm text-blue-600 font-semibold hover:underline">
          ➕ Ajouter une relation
        </button>
      </div>

      <div id="relationsContainer" class="space-y-3"></div>
      <p id="noRelations" class="text-sm text-gray-400 italic">Aucune relation ajoutée</p>
    </div>

    <!-- BOUTON FINAL -->
    <button id="btnSubmit" type="button"
      class="w-full bg-blue-600 text-white font-semibold py-3 rounded-xl hover:bg-blue-700 transition shadow-md">
      ✅ Créer la personne
    </button>

    <a href="/" class="block text-center text-sm text-gray-400 hover:underline">Annuler</a>
  </div>

  <!-- TEMPLATE relation row -->
  <template id="relationTemplate">
    <div class="relation-row border border-gray-200 rounded-xl p-4 space-y-3 bg-gray-50" data-type="CONJOINT" data-person-id="">
      <div class="flex items-center justify-between">
        <div class="flex gap-2">
          <button type="button" data-type="CONJOINT"
            class="type-btn py-1 px-3 rounded-lg border-2 border-blue-500 bg-blue-50 text-blue-700 font-semibold text-xs transition">
            💍 Conjoint
          </button>
          <button type="button" data-type="PARENT"
            class="type-btn py-1 px-3 rounded-lg border-2 border-gray-200 text-gray-500 font-semibold text-xs transition">
            👨 Parent de
          </button>
          <button type="button" data-type="ENFANT"
            class="type-btn py-1 px-3 rounded-lg border-2 border-gray-200 text-gray-500 font-semibold text-xs transition">
            👶 Enfant de
          </button>
        </div>
        <button type="button" class="btn-remove text-gray-300 hover:text-red-400 text-lg font-bold">✕</button>
      </div>

      <!-- Recherche personne -->
      <div class="relative">
        <input type="text" placeholder="Rechercher une personne…"
          class="person-search w-full rounded-lg border-gray-300 text-sm" autocomplete="off" required/>
        <ul class="person-results absolute z-10 w-full bg-white border border-gray-200 rounded-lg hidden max-h-40 overflow-y-auto divide-y divide-gray-100 shadow-md"></ul>
        <p class="person-selected text-xs text-blue-700 font-medium mt-1 hidden"></p>
      </div>

      <!-- Options CONJOINT -->
      <div class="options-conjoint space-y-2">
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-xs text-gray-500 mb-0.5">Statut</label>
            <select class="conjoint-status w-full rounded-lg border-gray-300 text-sm">
              <option value="ACTIVE">✅ En couple</option>
              <option value="DIVORCED">❌ Divorcé</option>
            </select>
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-0.5">Date début</label>
            <input type="date" class="conjoint-date-debut w-full rounded-lg border-gray-300 text-sm" />
          </div>
        </div>
      </div>

      <!-- Options PARENT/ENFANT -->
      <div class="options-parent hidden">
        <label class="block text-xs text-gray-500 mb-0.5">Couple associé (optionnel)</label>
        <select class="couple-relation-id w-full rounded-lg border-gray-300 text-sm">
          <option value="">— Aucun couple —</option>
        </select>
      </div>
    </div>
  </template>
</Baselayout>

<script define:vars={{ personsData, coupleRelationsData }}>
  const container = document.getElementById("relationsContainer");
  const noRelations = document.getElementById("noRelations");
  const template = document.getElementById("relationTemplate");

  function updateNoRelations() {
    noRelations.classList.toggle("hidden", container.children.length > 0);
  }

  function setupRelationRow(row) {
    const typeBtns = row.querySelectorAll(".type-btn");
    const optionsConjoint = row.querySelector(".options-conjoint");
    const optionsParent = row.querySelector(".options-parent");
    const searchInput = row.querySelector(".person-search");
    const resultsList = row.querySelector(".person-results");
    const personSelected = row.querySelector(".person-selected");
    const coupleSelect = row.querySelector(".couple-relation-id");

    // Type buttons
    typeBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const currentType = btn.dataset.type;
        row.dataset.type = currentType;

        typeBtns.forEach(b => {
          b.classList.remove("border-blue-500", "bg-blue-50", "text-blue-700");
          b.classList.add("border-gray-200", "text-gray-500");
        });
        btn.classList.add("border-blue-500", "bg-blue-50", "text-blue-700");
        btn.classList.remove("border-gray-200", "text-gray-500");

        optionsConjoint.classList.toggle("hidden", currentType !== "CONJOINT");
        optionsParent.classList.toggle("hidden", currentType === "CONJOINT");
        updateCoupleOptions();
      });
    });

    // Recherche personne
    searchInput.addEventListener("input", () => {
      const q = searchInput.value.toLowerCase().trim();
      resultsList.innerHTML = "";
      if (!q) { resultsList.classList.add("hidden"); return; }

      const matches = personsData
        .filter(p => `${p.prenom} ${p.nom}`.toLowerCase().includes(q))
        .slice(0, 8);

      if (!matches.length) { resultsList.classList.add("hidden"); return; }

      matches.forEach(p => {
        const li = document.createElement("li");
        li.className = "px-3 py-2 hover:bg-blue-50 cursor-pointer text-sm text-gray-700";
        li.textContent = `${p.prenom} ${p.nom}`;
        li.addEventListener("click", () => {
          // ✅ Stockage dans data-attribute sur la row directement
          row.dataset.personId = p._id;
          personSelected.textContent = `✓ ${p.prenom} ${p.nom}`;
          personSelected.classList.remove("hidden");
          searchInput.value = `${p.prenom} ${p.nom}`;
          resultsList.classList.add("hidden");
          updateCoupleOptions(p._id);
        });
        resultsList.appendChild(li);
      });
      resultsList.classList.remove("hidden");
    });

    document.addEventListener("click", (e) => {
      if (!searchInput.contains(e.target) && !resultsList.contains(e.target)) {
        resultsList.classList.add("hidden");
      }
    });

    function updateCoupleOptions(personId) {
      coupleSelect.innerHTML = '<option value="">— Aucun couple —</option>';
      const filtered = personId
        ? coupleRelationsData.filter(c => c.fromId === personId || c.toId === personId)
        : coupleRelationsData;
      filtered.forEach(c => {
        const opt = document.createElement("option");
        opt.value = c._id;
        opt.textContent = c.label;
        coupleSelect.appendChild(opt);
      });
      if (filtered.length === 1) coupleSelect.value = filtered[0]._id;
    }
    updateCoupleOptions();

    row.querySelector(".btn-remove").addEventListener("click", () => {
      row.remove();
      updateNoRelations();
    });
  }

  document.getElementById("btnAddRelation").addEventListener("click", () => {
    const clone = template.content.cloneNode(true);
    container.appendChild(clone);
    const row = container.lastElementChild;
    setupRelationRow(row);
    updateNoRelations();
  });

  // Submit final
  document.getElementById("btnSubmit").addEventListener("click", async () => {
    const prenom = document.getElementById("prenom").value.trim();
    const nom = document.getElementById("nom").value.trim();

    if (!prenom || !nom) {
      alert("Le prénom et le nom sont obligatoires.");
      return;
    }

    // 1. Créer la personne
    const personRes = await fetch("/api/persons", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        prenom,
        nom,
        sexe: document.getElementById("sexe").value || undefined,
        dateNaissance: document.getElementById("dateNaissance").value || undefined,
        dateDeces: document.getElementById("dateDeces").value || undefined,
        email: document.getElementById("email").value || undefined,
        active: true,
      }),
    });

    if (!personRes.ok) {
      alert("Erreur lors de la création de la personne.");
      return;
    }

    const { _id: newPersonId } = await personRes.json();

    // 2. Créer les relations
    const rows = container.querySelectorAll(".relation-row");
    for (const row of rows) {
      const type = row.dataset.type;
      const personId = row.dataset.personId; // ✅ Lu depuis data-attribute

      console.log("type:", type, "personId:", personId);

      if (!personId) {
        console.log("⚠️ personId vide, relation ignorée");
        continue;
      }

      let payload = {};

      if (type === "CONJOINT") {
        payload = {
          type: "CONJOINT",
          from: newPersonId,
          to: personId,
          status: row.querySelector(".conjoint-status").value,
          dateDebut: row.querySelector(".conjoint-date-debut").value || null,
        };
      } else {
        const coupleRelationId = row.querySelector(".couple-relation-id").value;
        payload = {
          type: "PARENT",
          from: type === "PARENT" ? newPersonId : personId,
          to: type === "PARENT" ? personId : newPersonId,
          ...(coupleRelationId ? { coupleRelationId } : {}),
        };
      }

      console.log("payload relation:", payload);

      const relRes = await fetch("/api/relations", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const relData = await relRes.text();
      console.log("réponse relation:", relRes.status, relData);
    }

    alert("Personne et relations créées !");
    window.location.href = `/person/${newPersonId}`;
  });
</script>