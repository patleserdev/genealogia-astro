---
// src/pages/invite.astro
import Baselayout from "../layouts/Baselayout.astro";

const token = Astro.url.searchParams.get("token");
if (!token) return Astro.redirect("/");
---

<Baselayout title="Rejoindre l’arbre">
  <div class="h-full flex items-center justify-center bg-stone-50 px-6 py-10">
    <div class="w-full max-w-lg">
      <div
        class="bg-white rounded-2xl shadow-sm border border-stone-200 p-6 space-y-6"
      >
        <!-- Header -->
        <div class="text-center">
          <div
            class="w-12 h-12 mx-auto rounded-full bg-amber-100 flex items-center justify-center mb-3"
          >
            <svg
              class="w-6 h-6 text-amber-700"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1"></path>
            </svg>
          </div>

          <h1 class="text-xl font-semibold text-stone-800">
            Invitation à rejoindre l’arbre
          </h1>

          <p class="text-sm text-stone-500 mt-1">
            Créez votre compte pour accéder à votre famille
          </p>
        </div>

        <!-- Form -->
        <form id="form" data-token={token} class="space-y-4">
          <input type="hidden" name="token" value={token} />

          <!-- Nom -->
          <div class="grid grid-cols-2 gap-3">
            <input name="prenom" required placeholder="Prénom" class="input" />
            <input name="nom" required placeholder="Nom" class="input" />
          </div>

          <!-- Email -->
          <div class="grid grid-cols-1 gap-3">
            <input
              id="email"
              type="email"
              name="email"
              required
              placeholder="Adresse email"
              autocomplete="email"
              class="input"
            />
          </div>

          <!-- Password -->
          <div>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                placeholder="Mot de passe"
                class="input pr-10"
              />
              <button
                type="button"
                id="togglePassword"
                tabindex="-1"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-600"
              >
                <svg
                  id="eyePassword"
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </button>
            </div>

            <div class="mt-2 flex gap-1">
              <div class="bar"></div><div class="bar"></div><div class="bar">
              </div><div class="bar"></div>
            </div>

            <div class="rules mt-2 text-xs grid grid-cols-2 gap-2">
              <span data-rule="length">8 caractères</span>
              <span data-rule="upper">Majuscule</span>
              <span data-rule="lower">Minuscule</span>
              <span data-rule="number">Chiffre</span>
            </div>
          </div>

          <!-- Confirm -->
          <div>
            <div class="relative">
              <input
                type="password"
                id="confirm"
                required
                placeholder="Confirmer le mot de passe"
                class="input pr-10"
              />
              <button
                type="button"
                id="toggleConfirm"
                tabindex="-1"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-600"
              >
                <svg
                  id="eyeConfirm"
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </button>
            </div>
            <p id="matchMsg" class="text-xs mt-1 hidden"></p>
          </div>

          <!-- SEARCH -->
          <div class="relative">
            <input
              id="search"
              placeholder="Déjà dans l’arbre ?"
              class="input"
            />
            <ul
              id="results"
              class="absolute z-10 w-full bg-white border rounded-xl mt-1"
            >
            </ul>
            <input type="hidden" name="personId" id="personId" />
          </div>

          <!-- Error -->
          <p id="error" class="hidden text-red-600 text-sm"></p>

          <!-- Submit -->
          <button
            id="btn"
            class="w-full py-2.5 bg-amber-600 hover:bg-amber-700 text-white rounded-lg"
          >
            Créer mon compte
          </button>
        </form>
      </div>
    </div>
  </div>

 <script>
  const form = document.getElementById("form") as HTMLFormElement | null;
  if (!form) throw new Error("Formulaire introuvable");

  const token = form.dataset.token ?? "";
  const inviteToken = token;

  const res = await fetch(`/api/invitations/validate?token=${token}`);

  if (!res.ok) {
    document.body.innerHTML = `
      <div class="h-screen flex items-center justify-center text-stone-600">
        Invitation invalide ou expirée
      </div>
    `;
    throw new Error("Invitation invalide");
  }

  const invitation = await res.json();
  const emailInput = document.getElementById("email") as HTMLInputElement;

  emailInput.value = invitation.toEmail ?? "";
  emailInput.readOnly = true;

  /* RULES */
  const RULES: Record<string, (v: string) => boolean> = {
    length: (v) => v.length >= 8,
    upper: (v) => /[A-Z]/.test(v),
    lower: (v) => /[a-z]/.test(v),
    number: (v) => /[0-9]/.test(v),
  };

  const password = document.getElementById("password") as HTMLInputElement;
  const confirm = document.getElementById("confirm") as HTMLInputElement;
  const matchMsg = document.getElementById("matchMsg") as HTMLElement;

  /* TOGGLE VISIBILITÉ MOT DE PASSE */
  function setupToggle(inputEl: HTMLInputElement, btnId: string, eyeId: string) {
    const btn = document.getElementById(btnId) as HTMLButtonElement | null;
    const eye = document.getElementById(eyeId) as SVGElement | null;
    if (!btn || !eye) return;

    const eyeOpenPath = `
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
        d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
    `;

    const eyeClosedPath = `
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
        d="M3.98 8.223A10.477 10.477 0 001.934 12c1.292 4.338 5.31 7.5 10.066 7.5.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
    `;

    btn.addEventListener("click", () => {
      const isPassword = inputEl.type === "password";
      inputEl.type = isPassword ? "text" : "password";
      eye.innerHTML = isPassword ? eyeClosedPath : eyeOpenPath;
    });
  }

  setupToggle(password, "togglePassword", "eyePassword");
  setupToggle(confirm, "toggleConfirm", "eyeConfirm");

  function checkRules(v: string): number {
    return Object.keys(RULES).filter((r) => RULES[r](v)).length;
  }

  password.addEventListener("input", () => {
    const val = password.value;
    const score = checkRules(val);

    document.querySelectorAll<HTMLElement>("[data-rule]").forEach((el) => {
      const rule = el.dataset.rule;
      if (!rule) return;
      const ok = RULES[rule](val);
      el.classList.toggle("text-green-600", ok);
    });

    const bars = document.querySelectorAll<HTMLElement>(".bar");
    bars.forEach((b, i) => {
      b.className = "bar " + (i < score ? "bg-green-400" : "bg-stone-100");
    });
  });

  confirm.addEventListener("input", () => {
    const ok = password.value === confirm.value;
    matchMsg.textContent = ok ? "✓ OK" : "✗ différent";
    matchMsg.classList.remove("hidden");
    matchMsg.className = ok
      ? "text-green-600 text-xs"
      : "text-red-500 text-xs";
  });

  /* SEARCH */
  const search = document.getElementById("search") as HTMLInputElement;
  const results = document.getElementById("results") as HTMLUListElement;
  const personId = document.getElementById("personId") as HTMLInputElement;

  let t: ReturnType<typeof setTimeout>;

  search.addEventListener("input", () => {
    clearTimeout(t);
    const q = search.value.trim();
    if (q.length < 2) {
      results.innerHTML = "";
      return;
    }

    t = setTimeout(async () => {
      const url = new URL("/api/persons/search", window.location.origin);
      url.searchParams.set("q", q);
      url.searchParams.set("inviteToken", inviteToken);

      const data: { _id: string; prenom: string; nom: string }[] =
        await fetch(url).then((r) => r.json());

      results.innerHTML = data
        .map(
          (p) => `
            <li data-id="${p._id}" class="px-3 py-2 hover:bg-amber-50 cursor-pointer">
              ${p.prenom} ${p.nom}
            </li>`,
        )
        .join("");
    }, 300);
  });

  results.addEventListener("click", (e: MouseEvent) => {
    const target = e.target as HTMLElement | null;
    const li = target?.closest("li") as HTMLElement | null;
    if (!li) return;

    personId.value = li.dataset.id ?? "";
    search.value = li.textContent ?? "";
    results.innerHTML = "";
  });

  /* SUBMIT */
  const errorEl = document.getElementById("error") as HTMLElement;
  const btn = document.getElementById("btn") as HTMLButtonElement;

  form.addEventListener("submit", async (e: SubmitEvent) => {
    e.preventDefault();

    if (checkRules(password.value) < 4) {
      errorEl.textContent = "Mot de passe trop faible";
      errorEl.classList.remove("hidden");
      return;
    }

    if (password.value !== confirm.value) {
      errorEl.textContent = "Les mots de passe ne correspondent pas";
      errorEl.classList.remove("hidden");
      return;
    }

    btn.disabled = true;
    btn.textContent = "Création...";

    const data = Object.fromEntries(new FormData(form));

    const submitRes = await fetch("/api/invitations/accept", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data),
    });

    if (submitRes.ok) {
      window.location.href = "/login";
    } else {
      const { error: err } = await submitRes.json();
      errorEl.textContent = err;
      errorEl.classList.remove("hidden");
      btn.disabled = false;
      btn.textContent = "Créer mon compte";
    }
  });
</script>
</Baselayout>
