---
import DeleteButton from "../components/DeleteButton.astro";
import Baselayout from "../layouts/Baselayout.astro";

import { relations, persons } from "../lib/mongo";
import { ObjectId } from "mongodb";

export const prerender = false;

// Récupérer toutes les relations
const allRelations = await relations.find({}).toArray();

// Récupérer tous les IDs de personnes
const personIds = Array.from(
    new Set(allRelations.flatMap((r) => [r.from.toString(), r.to.toString()])),
);
const personsObjs = await persons
    .find({ _id: { $in: personIds.map((id) => new ObjectId(id)) } })
    .toArray();
const personsMap = Object.fromEntries(
    personsObjs.map((p) => [p._id.toString(), p]),
);
---

<Baselayout title="Toutes les relations">
    <h2 class="text-2xl font-bold mb-4">Toutes les relations</h2>

    <table class="min-w-full bg-white shadow-md rounded-lg overflow-hidden">
        <thead class="bg-gray-100 border-b">
            <tr>
                <th class="p-2 text-left">Type</th>
                <th class="p-2 text-left">De</th>
                <th class="p-2 text-left">Vers</th>
                <th class="p-2 text-left">Statut</th>
                <th class="p-2 text-left">Actions</th>
            </tr>
        </thead>
        <tbody>
            {
                allRelations.map((r) => (
                    <tr class="border-b hover:bg-gray-50">
                        <td class="p-2 border-1 p-1 bg-green-200">{r.type}</td>
                        <td class="p-2">
                            {personsMap[
                                r.from.toString()
                            ]?.prenom.toUpperCase()}{" "}
                            {personsMap[r.from.toString()]?.nom}
                        </td>
                        <td class="p-2">
                            {personsMap[r.to.toString()]?.prenom}{" "}
                            {personsMap[r.to.toString()]?.nom}
                        </td>
                        <td class="p-2">{r.status || "—"}</td>
                        <td class="p-2 flex flex-row gap-2">
                            <form
                                id={`form-${r._id}`}
                                class="flex gap-2 items-center"
                            >
                                <select
                                    name="status"
                                    class="border rounded px-2 py-1"
                                >
                                    <option
                                        value="ACTIVE"
                                        selected={r.status === "ACTIVE"}
                                    >
                                        ACTIVE
                                    </option>
                                    <option
                                        value="DIVORCED"
                                        selected={r.status === "DIVORCED"}
                                    >
                                        DIVORCED
                                    </option>
                                </select>
                                <button class="px-2 py-1 bg-yellow-500 text-white rounded hover:bg-yellow-600">
                                    Modifier
                                </button>
                            </form>

                            <DeleteButton relationId={r._id} />
                        </td>
                    </tr>
                ))
            }
        </tbody>
    </table>
    <script is:inline>
        document.querySelectorAll('form[id^="form-"]').forEach((form) => {
            form.addEventListener("submit", async (e) => {
                e.preventDefault();
                const data = Object.fromEntries(new FormData(form));
                const id = form.id.replace("form-", "");
                await fetch(`/api/relations/${id}`, {
                    method: "PATCH",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data),
                });
                location.reload();
            });
        });
    </script>
</BaseLayout>
