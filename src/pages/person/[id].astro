---
import Baselayout from "../../layouts/Baselayout.astro";
import { persons, relations } from "../../lib/mongo";
import { ObjectId } from "mongodb";
import { formatFullName } from "../../utils/formatName.ts";
import { formatDateFR } from "../../utils/formatDate.ts";

export const prerender = false;

const { id } = Astro.params;
const personId = new ObjectId(id);

// 1. Récupérer la personne
const person = await persons.findOne({ _id: personId });
if (!person) throw new Error("Personne non trouvée");

// 2. Récupérer toutes les relations CONJOINT de cette personne
const allSpouseRels = await relations
  .find({
    type: "CONJOINT",
    $or: [{ from: personId }, { to: personId }],
  })
  .toArray();

// 3. Récupérer toutes les relations PARENT où cette personne est enfant
const parentRels = await relations
  .find({
    type: "PARENT",
    to: personId,
  })
  .toArray();

// 4. Récupérer toutes les relations PARENT où cette personne est parent
const myChildRels = await relations
  .find({
    type: "PARENT",
    from: personId,
  })
  .toArray();

// 5. Construire la liste des conjoints/ex-conjoints avec enfants
const spouseEntries = [];

for (const rel of allSpouseRels) {
  const fromId =
    typeof rel.from === "string" ? new ObjectId(rel.from) : rel.from;
  const toId = typeof rel.to === "string" ? new ObjectId(rel.to) : rel.to;

  const spouseId = fromId.equals(personId) ? toId : fromId;
  const spousePerson = await persons.findOne({ _id: spouseId });

  // Enfants liés à ce couple
  const coupleId =
    typeof rel._id === "string" ? new ObjectId(rel._id) : rel._id;
  const childrenRels = await relations
    .find({
      type: "PARENT",
      coupleRelationId: coupleId,
    })
    .toArray();

  const childrenIds = childrenRels.map((r) =>
    typeof r.to === "string" ? new ObjectId(r.to) : r.to,
  );

  const children =
    childrenIds.length > 0
      ? await persons.find({ _id: { $in: childrenIds } }).toArray()
      : [];

  spouseEntries.push({
    relId: rel._id.toString(),
    spousePerson,
    status: rel.status ?? "ACTIVE",
    dateDebut: rel.dateDebut,
    dateFin: rel.dateFin,
    children,
  });
}

// 6. Enfants sans couple associé
const orphanChildRels = myChildRels.filter((r) => !r.coupleRelationId);
const orphanChildren =
  orphanChildRels.length > 0
    ? await persons
        .find({
          _id: {
            $in: orphanChildRels.map((r) =>
              typeof r.to === "string" ? new ObjectId(r.to) : r.to,
            ),
          },
        })
        .toArray()
    : [];

// 7. Parents directs (relations PARENT où cette personne est enfant)

const parentIds = parentRels.map((r) =>
  typeof r.from === "string" ? new ObjectId(r.from) : r.from,
);

// Récupérer aussi les seconds parents via coupleRelationId
for (const rel of parentRels) {
  if (rel.coupleRelationId) {
    const coupleRel = await relations.findOne({ _id: rel.coupleRelationId });
    if (coupleRel) {
      const fromId =
        typeof coupleRel.from === "string"
          ? new ObjectId(coupleRel.from)
          : coupleRel.from;
      const toId =
        typeof coupleRel.to === "string"
          ? new ObjectId(coupleRel.to)
          : coupleRel.to;
      // Ajouter l'autre parent s'il n'est pas déjà dans la liste
      const otherParentId = fromId.equals(parentIds[0]) ? toId : fromId;
      if (!parentIds.some((id) => id.equals(otherParentId))) {
        parentIds.push(otherParentId);
      }
    }
  }
}

const parentObjs =
  parentIds.length > 0
    ? await persons.find({ _id: { $in: parentIds } }).toArray()
    : [];

// 8. Frères et sœurs
const siblings: any[] = [];

for (const rel of parentRels) {
  if (rel.coupleRelationId) {
    // Tous les enfants du même couple
    const siblingRels = await relations
      .find({
        type: "PARENT",
        coupleRelationId: rel.coupleRelationId,
        to: { $ne: personId }, // exclure la personne elle-même
      })
      .toArray();

    for (const sibRel of siblingRels) {
      const sibId =
        typeof sibRel.to === "string" ? new ObjectId(sibRel.to) : sibRel.to;
      if (!siblings.some((s) => s._id.equals(sibId))) {
        const sibPerson = await persons.findOne({ _id: sibId });
        if (sibPerson) siblings.push(sibPerson);
      }
    }
  }
}
---

<Baselayout title={`${formatFullName(person.prenom, person.nom)}`}>
  <div class="max-w-6xl mx-auto p-4">
    <h2 class="text-2xl font-bold mb-4 text-center">
      {formatFullName(person.prenom, person.nom)}
    </h2>

    <div class="text-center mb-6">
      <a
        href={`/tree/${person._id}`}
        class="text-blue-600 hover:underline text-sm font-medium"
      >
        Vue arbre
      </a>
    </div>

    <!-- Infos personnelles centrées -->
    <div class="bg-white shadow-md rounded-lg p-6 mb-8 mx-auto max-w-md">
      <p><span class="font-semibold">Email :</span> {person.email || "Non renseigné"}</p>
      <p><span class="font-semibold">Date de naissance :</span> {formatDateFR(person.dateNaissance) || "Non renseignée"}</p>
      
      {person.dateDeces && <p><span class="font-semibold">Date de décès :</span> {formatDateFR(person.dateDeces)}</p>}
      <p><span class="font-semibold">Sexe :</span> {person.sexe || "Non renseigné"}</p>
      {person.notes && <p class="mt-2 text-gray-600 italic">{person.notes}</p>}
      <a
        href={`/addperson?id=${person._id}&returnUrl=${encodeURIComponent(Astro.url.pathname)}`}
        class="text-amber-600 hover:underline text-sm font-medium mt-2 inline-block"
      >
        Modifier
      </a>
    </div>

    <!-- Grille équilibrée -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Parents -->
      <div class="bg-white shadow-md rounded-lg p-4">
        <h3 class="font-semibold mb-2 text-gray-700 text-lg">Parents</h3>
        {parentObjs.length > 0 ? (
          <ul class="space-y-1">
            {parentObjs.map(p => (
              <li>
                <a href={`/person/${p._id}`} class="text-blue-600 hover:underline">
                  {formatFullName(p.prenom, p.nom)}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-gray-400">Aucun parent enregistré</p>
        )}
      </div>

      <!-- Frères & Sœurs -->
      <div class="bg-white shadow-md rounded-lg p-4">
        <h3 class="font-semibold mb-2 text-gray-700 text-lg">Frères & Sœurs</h3>
        {siblings.length > 0 ? (
          <ul class="space-y-1">
            {siblings.map(s => (
              <li>
                <a href={`/person/${s._id}`} class="text-blue-600 hover:underline">
                  {formatFullName(s.prenom, s.nom)}
                </a>
                {s.dateNaissance && (
                  <span class="text-gray-400 text-xs ml-2">({formatDateFR(s.dateNaissance)})</span>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-gray-400">Aucun frère ou sœur enregistré</p>
        )}
      </div>

      <!-- Conjoints & Enfants -->
      <div class="bg-white shadow-md rounded-lg p-4">
        <h3 class="font-semibold mb-3 text-gray-700 text-lg">Relations & Enfants</h3>
        {spouseEntries.length > 0 ? (
          <div class="space-y-4">
            {spouseEntries.map(entry => (
              <div class={`border rounded-lg p-3 ${entry.status === "ACTIVE" ? "border-green-300 bg-green-50" : "border-gray-200 bg-gray-50"}`}>
                <div class="flex items-center gap-2 mb-2">
                  <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${entry.status === "ACTIVE" ? "bg-green-200 text-green-800" : "bg-gray-200 text-gray-600"}`}>
                    {entry.status === "ACTIVE" ? "Conjoint(e)" : "Ex-conjoint(e)"}
                  </span>
                  {entry.spousePerson ? (
                    <a href={`/person/${entry.spousePerson._id}`} class="font-medium text-blue-600 hover:underline">
                      {formatFullName(entry.spousePerson.prenom, entry.spousePerson.nom)}
                    </a>
                  ) : (
                    <span class="text-gray-400 italic">Personne supprimée</span>
                  )}
                </div>

                {(entry.dateDebut || entry.dateFin) && (
                  <p class="text-xs text-gray-500 mb-2">
                    {entry.dateDebut && <>Depuis le {formatDateFR(entry.dateDebut)}</>}
                    {entry.dateFin && <> — jusqu'au {formatDateFR(entry.dateFin)}</>}
                  </p>
                )}

                {entry.children.length > 0 ? (
                  <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">
                      Enfants communs ({entry.children.length})
                    </p>
                    <ul class="space-y-0.5">
                      {entry.children.map(c => (
                        <li class="flex items-center gap-1 text-sm">
                          <span class="text-gray-400">↳</span>
                          <a href={`/person/${c._id}`} class="text-blue-600 hover:underline">
                            {formatFullName(c.prenom, c.nom)}
                          </a>
                          {c.dateNaissance && <span class="text-gray-400 text-xs">({c.dateNaissance})</span>}
                        </li>
                      ))}
                    </ul>
                  </div>
                ) : (
                  <p class="text-xs text-gray-400 italic">Aucun enfant commun enregistré</p>
                )}
              </div>
            ))}
          </div>
        ) : (
          <p class="text-gray-400">Aucune relation enregistrée</p>
        )}
      </div>

      <!-- Enfants sans couple associé -->
      {orphanChildren.length > 0 && (
        <div class="bg-white shadow-md rounded-lg p-4">
          <h3 class="font-semibold mb-2 text-gray-700 text-lg">Enfants (sans relation associée)</h3>
          <ul class="space-y-1">
            {orphanChildren.map(c => (
              <li>
                <a href={`/person/${c._id}`} class="text-blue-600 hover:underline">
                  {formatFullName(c.prenom, c.nom)}
                </a>
                {c.dateNaissance && <span class="text-gray-400 text-xs ml-2">({formatDateFR(c.dateNaissance)})</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="mt-6 text-center">
      <a href="/" class="inline-block text-blue-600 hover:underline">← Retour à l'accueil</a>
    </div>
  </div>
</Baselayout>
