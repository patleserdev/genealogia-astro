---
<Baselayout title="Fonctionnalités">
    <div class="max-w-5xl mx-auto px-6 py-10">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">
            Fonctionnalités
          </h1>
  
          <p class="text-sm text-zinc-500 mt-1">
            Suivi du développement et des tests
          </p>
        </div>
  
        <div class="flex items-center gap-3 text-xs">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            <span>Développé</span>
          </div>
  
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-amber-500"></span>
            <span>En attente</span>
          </div>
  
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-sky-500"></span>
            <span>Testé</span>
          </div>
        </div>
      </div>
  
      <div class="space-y-8">
        {
          modules.map((module) => {
            const doneCount = module.childs.filter(
              (c) => c.status === "done"
            ).length;
  
            const progress = Math.round(
              (doneCount / module.childs.length) * 100
            );
  
            return (
              <section class="rounded-2xl border border-zinc-200 bg-white shadow-sm overflow-hidden">
                <div class="border-b border-zinc-100 px-6 py-5">
                  <div class="flex items-center justify-between gap-4">
                    <div>
                      <h2 class="text-xl font-semibold">
                        {module.title}
                      </h2>
  
                      <p class="text-sm text-zinc-500 mt-1">
                        {doneCount} / {module.childs.length} fonctionnalités
                        développées
                      </p>
                    </div>
  
                    <div class="text-right min-w-[80px]">
                      <div class="text-lg font-bold">
                        {progress}%
                      </div>
  
                      <div class="text-xs text-zinc-500">
                        progression
                      </div>
                    </div>
                  </div>
  
                  <div class="mt-4 h-2 rounded-full bg-zinc-100 overflow-hidden">
                    <div
                      class="h-full bg-emerald-500 transition-all duration-300"
                      style={`width:${progress}%`}
                    />
                  </div>
                </div>
  
                <ul class="divide-y divide-zinc-100">
                  {module.childs.map((child) => (
                    <li class="px-6 py-4 hover:bg-zinc-50 transition-colors">
                      <div class="flex items-start justify-between gap-4">
                        <div class="flex-1">
                          <p class="font-medium text-sm leading-6 text-zinc-800">
                            {child.title}
                          </p>
  
                          {child.priority && (
                            <div class="mt-2">
                              <span
                                class={`inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-medium border
                                ${
                                  child.priority === "critical"
                                    ? "bg-red-50 text-red-700 border-red-200"
                                    : child.priority === "high"
                                    ? "bg-orange-50 text-orange-700 border-orange-200"
                                    : child.priority === "medium"
                                    ? "bg-yellow-50 text-yellow-700 border-yellow-200"
                                    : "bg-zinc-100 text-zinc-700 border-zinc-200"
                                }`}
                              >
                                {child.priority}
                              </span>
                            </div>
                          )}
                        </div>
  
                        <div class="flex items-center gap-2 shrink-0">
                          {/* STATUS */}
                          <span
                            class={`inline-flex items-center gap-1 rounded-full px-3 py-1 text-xs font-semibold border uppercase tracking-wide
                            ${
                              child.status === "done"
                                ? "bg-emerald-50 text-emerald-700 border-emerald-200"
                                : "bg-amber-50 text-amber-700 border-amber-200"
                            }`}
                          >
                            <span
                              class={`w-2 h-2 rounded-full
                              ${
                                child.status === "done"
                                  ? "bg-emerald-500"
                                  : "bg-amber-500"
                              }`}
                            />
  
                            {child.status === "done"
                              ? "développé"
                              : "todo"}
                          </span>
  
                          {/* TESTED */}
                          <span
                            class={`inline-flex items-center gap-1 rounded-full px-3 py-1 text-xs font-semibold border
                            ${
                              child.tested
                                ? "bg-sky-50 text-sky-700 border-sky-200"
                                : "bg-zinc-100 text-zinc-500 border-zinc-200"
                            }`}
                          >
                            <span
                              class={`w-2 h-2 rounded-full
                              ${
                                child.tested
                                  ? "bg-sky-500"
                                  : "bg-zinc-400"
                              }`}
                            />
  
                            {child.tested ? "testé" : "non testé"}
                          </span>
                        </div>
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        }
      </div>
    </div>
  </Baselayout>
