---
import Baselayout from "../layouts/Baselayout.astro";

const token = Astro.url.searchParams.get('token')
if (!token) return Astro.redirect('/login')
---

<Baselayout title="Réinitialiser le mot de passe">

<div class="h-full flex items-center justify-center bg-stone-50 px-6 py-10">
  <div class="w-full max-w-md">

    <div class="bg-white rounded-2xl border border-stone-200 shadow-sm p-6 space-y-6">

      <!-- Header -->
      <div class="text-center">
        <div class="w-12 h-12 mx-auto rounded-full bg-amber-100 flex items-center justify-center mb-3">
          <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M12 15v2m0-6a3 3 0 10-3-3m3 3a3 3 0 013-3m-3 3v1"/>
          </svg>
        </div>

        <h1 class="text-xl font-semibold text-stone-800">
          Nouveau mot de passe
        </h1>

        <p class="text-sm text-stone-500 mt-1">
          Choisissez un mot de passe sécurisé
        </p>
      </div>

      <!-- Form -->
      <form id="form" class="space-y-4">

        <input type="hidden" name="token" value={token} />

        <!-- Password -->
        <div>
          <label class="block text-xs font-medium text-stone-700 mb-1">
            Nouveau mot de passe
          </label>

          <input
            type="password"
            id="password"
            name="password"
            required
            placeholder="••••••••"
            class="w-full px-3 py-2 rounded-lg border border-stone-200 bg-stone-50 text-sm focus:ring-2 focus:ring-amber-500 outline-none"
          />

          <!-- strength -->
          <div class="mt-2 flex gap-1">
            <div class="bar"></div>
            <div class="bar"></div>
            <div class="bar"></div>
            <div class="bar"></div>
          </div>

          <!-- rules -->
          <div class="mt-2 grid grid-cols-2 gap-2 text-xs" id="rules">
            <span data-rule="length" class="text-stone-400">8 caractères</span>
            <span data-rule="upper"  class="text-stone-400">Majuscule</span>
            <span data-rule="lower"  class="text-stone-400">Minuscule</span>
            <span data-rule="number" class="text-stone-400">Chiffre</span>
          </div>
        </div>

        <!-- Confirm -->
        <div>
          <label class="block text-xs font-medium text-stone-700 mb-1">
            Confirmation
          </label>

          <input
            type="password"
            id="confirm"
            required
            placeholder="••••••••"
            class="w-full px-3 py-2 rounded-lg border border-stone-200 bg-stone-50 text-sm focus:ring-2 focus:ring-amber-500 outline-none"
          />

          <p id="matchMsg" class="text-xs mt-1 hidden"></p>
        </div>

        <!-- Error -->
        <p id="error"
          class="hidden text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2">
        </p>

        <!-- Success -->
        <p id="success"
          class="hidden text-sm text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg px-3 py-2">
          Mot de passe mis à jour avec succès.
        </p>

        <!-- Submit -->
        <button
          id="btn"
          class="w-full py-2.5 bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium rounded-lg transition">
          Réinitialiser
        </button>

      </form>

    </div>
  </div>
</div>

<script>

/* ── RULES ───────────────────────────── */
const RULES = {
  length: v => v.length >= 8,
  upper:  v => /[A-Z]/.test(v),
  lower:  v => /[a-z]/.test(v),
  number: v => /[0-9]/.test(v),
}

/* ── ELEMENTS ───────────────────────── */
const form = document.getElementById('form')
const password = document.getElementById('password')
const confirm = document.getElementById('confirm')
const error = document.getElementById('error')
const success = document.getElementById('success')
const btn = document.getElementById('btn')
const matchMsg = document.getElementById('matchMsg')

/* ── SAFE CHECK ─────────────────────── */
if (!form || !password || !confirm || !error || !success || !btn || !matchMsg) {
  console.error('Missing DOM elements', {
    form, password, confirm, error, success, btn, matchMsg
  })
}

/* ── HELPERS ───────────────────────── */
function score(v) {
  return Object.keys(RULES).filter(k => RULES[k](v)).length
}

/* ── PASSWORD STRENGTH ─────────────── */
if (password) {
  password.addEventListener('input', () => {
    const val = password.value
    const s = score(val)

    document.querySelectorAll('[data-rule]').forEach(el => {
      const rule = el.dataset.rule
      if (!rule) return

      el.classList.toggle('text-green-600', RULES[rule](val))
      el.classList.toggle('text-stone-400', !RULES[rule](val))
    })

    document.querySelectorAll('.bar').forEach((bar, i) => {
      bar.className = 'bar ' + (i < s ? 'bg-green-400' : 'bg-stone-100')
    })
  })
}

/* ── MATCH PASSWORD ─────────────── */
if (password && confirm && matchMsg) {
  confirm.addEventListener('input', () => {
    const ok = password.value === confirm.value

    matchMsg.classList.remove('hidden')
    matchMsg.textContent = ok
      ? '✓ Correspondent'
      : '✗ Ne correspondent pas'

    matchMsg.className = ok
      ? 'text-green-600 text-xs'
      : 'text-red-500 text-xs'
  })
}

/* ── SUBMIT ─────────────────────────── */
if (form) {
  form.addEventListener('submit', async (e) => {
    e.preventDefault()

    error.classList.add('hidden')
    success.classList.add('hidden')

    if (score(password.value) < 4) {
      error.textContent = 'Mot de passe trop faible'
      error.classList.remove('hidden')
      return
    }

    if (password.value !== confirm.value) {
      error.textContent = 'Les mots de passe ne correspondent pas'
      error.classList.remove('hidden')
      return
    }

    btn.disabled = true
    btn.textContent = 'Mise à jour...'

    const data = Object.fromEntries(new FormData(form))

    try {
      const res = await fetch('/api/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })

      const json = await res.json()

      if (res.ok) {
        success.classList.remove('hidden')

        setTimeout(() => {
          window.location.href = '/login'
        }, 1200)

      } else {
        error.textContent = json.error || 'Erreur'
        error.classList.remove('hidden')
        btn.disabled = false
        btn.textContent = 'Réinitialiser'
      }

    } catch (err) {
      error.textContent = 'Erreur réseau'
      error.classList.remove('hidden')
      btn.disabled = false
      btn.textContent = 'Réinitialiser'
    }
  })
}
</script>

</Baselayout>