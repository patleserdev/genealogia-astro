---
import Baselayout from "../layouts/Baselayout.astro";
---

<Baselayout title="Mot de passe oublié">

<div class="h-full flex items-center justify-center bg-stone-50 px-6 py-10">
  <div class="w-full max-w-md">

    <div class="bg-white rounded-2xl border border-stone-200 shadow-sm p-6 space-y-5">

      <!-- Header -->
      <div class="text-center space-y-2">
        <div class="w-12 h-12 mx-auto rounded-full bg-amber-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M12 15v2m0-6a3 3 0 10-3-3m3 3a3 3 0 013-3m-3 3v1"/>
          </svg>
        </div>

        <h1 class="text-xl font-semibold text-stone-800">
          Mot de passe oublié
        </h1>

        <p class="text-sm text-stone-500">
          Entrez votre email pour recevoir un lien de réinitialisation
        </p>
      </div>

      <!-- Form -->
      <form id="form" class="space-y-4">

        <div>
          <label class="text-xs font-medium text-stone-700">Email</label>
          <input
            type="email"
            name="email"
            required
            placeholder="vous@email.com"
            class="w-full mt-1 px-3 py-2 rounded-lg border border-stone-200 bg-stone-50 text-sm focus:ring-2 focus:ring-amber-500 outline-none"
          />
        </div>

        <!-- Message succès -->
        <p id="success"
          class="hidden text-sm text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg px-3 py-2">
          Un lien de réinitialisation a été envoyé à votre email si vous existez dans notre base de données.
        </p>

        <!-- Error -->
        <p id="error"
          class="hidden text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2">
        </p>

        <!-- Submit -->
        <button
          id="btn"
          class="w-full py-2.5 bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium rounded-lg transition">
          Envoyer le lien
        </button>

      </form>

      <!-- Footer -->
      <p class="text-center text-sm text-stone-500">
        <a href="/login" class="text-amber-700 hover:underline font-medium">
          Retour à la connexion
        </a>
      </p>

    </div>
  </div>
</div>

<script>
const form = document.getElementById('form') as HTMLFormElement | null
const btn = document.getElementById('btn') as HTMLButtonElement | null
const error = document.getElementById('error') as HTMLElement | null
const success = document.getElementById('success') as HTMLElement | null

if (form && btn && error && success) {
  form.addEventListener('submit', async (e) => {
    e.preventDefault()

    error.classList.add('hidden')
    success.classList.add('hidden')

    btn.disabled = true
    btn.textContent = 'Envoi...'

    const data = Object.fromEntries(new FormData(form))

    const res = await fetch('/api/auth/forgot-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })

    if (res.ok) {
      success.classList.remove('hidden')
      form.reset()
    } else {
      const { error: msg } = await res.json()
      error.textContent = msg || 'Erreur lors de l’envoi'
      error.classList.remove('hidden')
    }

    btn.disabled = false
    btn.textContent = 'Envoyer le lien'
  })
}
</script>

</Baselayout>