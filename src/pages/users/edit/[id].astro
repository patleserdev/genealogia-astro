---
import { ObjectId } from "mongodb";
import { verifyToken } from "../../../lib/auth.ts";
import { users } from "../../../lib/mongo.ts";
import Baselayout from "../../../layouts/Baselayout.astro";



export const prerender = false;

const token = Astro.cookies.get("token")?.value;
if (!token) return Astro.redirect("/login");

let payload;
try {
  payload = verifyToken(token);
} catch {
  return Astro.redirect("/login");
}

if (payload.role !== "OWNER") {
  return Astro.redirect("/");
}

const { id } = Astro.params;

const user = await users.findOne({ _id: new ObjectId(id) });

if (!user) {
  throw new Error("Utilisateur introuvable");
}

const isSelf = user._id.toString() === payload.userId;
---

<Baselayout title={`Modifier ${user.prenom} ${user.nom}`}>
  <div class="max-w-lg mx-auto px-6 py-8 space-y-6">

    <a
      href={`/users/${user._id}`}
      class="inline-flex items-center gap-2 text-sm text-stone-500 hover:text-stone-800 transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Retour
    </a>

    <div class="bg-white border border-stone-200 rounded-2xl p-6">

      <h1 class="text-xl font-semibold text-stone-800 mb-6">
        Modifier {user.prenom} {user.nom}
      </h1>

      <form id="edit-form" data-id={user._id.toString()} class="space-y-4">

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="text-xs text-stone-500 mb-1 block">Prénom</label>
            <input
              name="prenom"
              value={user.prenom}
              required
              class="w-full px-3 py-2 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
          </div>

          <div>
            <label class="text-xs text-stone-500 mb-1 block">Nom</label>
            <input
              name="nom"
              value={user.nom}
              required
              class="w-full px-3 py-2 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
          </div>
        </div>

        <div>
          <label class="text-xs text-stone-500 mb-1 block">Email</label>
          <input
            type="email"
            name="email"
            value={user.email}
            required
            class="w-full px-3 py-2 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
          />
        </div>

        <div>
          <label class="text-xs text-stone-500 mb-1 block">Rôle</label>
          <select
            name="role"
            disabled={isSelf}
            class="w-full px-3 py-2 border border-stone-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 disabled:bg-stone-50 disabled:text-stone-400"
          >
            <option value="OWNER" selected={user.role === "OWNER"}>Owner</option>
            <option value="GUEST" selected={user.role === "GUEST"}>Guest</option>
          </select>
          {isSelf && (
            <p class="text-xs text-stone-400 mt-1">
              Vous ne pouvez pas modifier votre propre rôle
            </p>
          )}
        </div>

        <p id="error" class="hidden text-red-600 text-sm"></p>
        <p id="success" class="hidden text-emerald-600 text-sm"></p>

        <div class="flex gap-2 pt-2">
          <button
            type="submit"
            id="submit-btn"
            class="flex-1 py-2.5 bg-amber-600 hover:bg-amber-700 text-white rounded-lg text-sm font-medium transition-colors"
          >
            Enregistrer
          </button>

          <a
            href={`/users/${user._id}`}
            class="flex-1 py-2.5 text-center bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-lg text-sm font-medium transition-colors"
          >
            Annuler
          </a>
        </div>

      </form>
    </div>
  </div>
</Baselayout>

<script>
  const form = document.getElementById("edit-form") as HTMLFormElement | null;
  if (!form) throw new Error("Formulaire introuvable");

  const id = form.dataset.id;
  const errorEl = document.getElementById("error") as HTMLElement;
  const successEl = document.getElementById("success") as HTMLElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    errorEl.classList.add("hidden");
    successEl.classList.add("hidden");

    submitBtn.disabled = true;
    submitBtn.textContent = "Enregistrement...";

    const formData = new FormData(form);
    const body = Object.fromEntries(formData);

    try {
      const res = await fetch(`/api/users/${id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });

      const data = await res.json();

      if (!res.ok) {
        errorEl.textContent = data.error || "Erreur lors de la modification";
        errorEl.classList.remove("hidden");
        return;
      }

      successEl.textContent = "Modifications enregistrées";
      successEl.classList.remove("hidden");

      setTimeout(() => {
        window.location.href = `/users/${id}`;
      }, 800);
    } catch {
      errorEl.textContent = "Erreur réseau";
      errorEl.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Enregistrer";
    }
  });
</script>