---
import { ObjectId } from "mongodb";
import Baselayout from "../../layouts/Baselayout.astro";
import { verifyToken } from "../../lib/auth.ts";
import { db, users,changeRequests } from "../../lib/mongo.ts";

export const prerender = false;

const token = Astro.cookies.get("token")?.value;
if (!token) return Astro.redirect("/login");

let payload;

try {
  payload = verifyToken(token);
} catch {
  return Astro.redirect("/login");
}

if (payload.role !== "OWNER") {
  return Astro.redirect("/");
}

const { id } = Astro.params;

const user = await users.findOne({
  _id: new ObjectId(id),
});

if (!user) {
  throw new Error("Utilisateur introuvable");
}

function formatRole(role: string) {
  if (role === "OWNER") {
    return {
      label: "Owner",
      color: "bg-amber-50 text-amber-700 border border-amber-200",
    };
  }

  return {
    label: "Guest",
    color: "bg-stone-100 text-stone-600 border border-stone-200",
  };
}

const role = formatRole(user.role);

const moderationRequests = await changeRequests
  .find({
    requestedByUserId: user._id,
  })
  .sort({ createdAt: -1 })
  .toArray();

function formatStatus(status: string) {
  if (status === "ACCEPTED") {
    return {
      label: "Acceptée",
      color: "bg-emerald-50 text-emerald-700 border-emerald-200",
    };
  }

  if (status === "REJECTED") {
    return {
      label: "Refusée",
      color: "bg-red-50 text-red-700 border-red-200",
    };
  }

  return {
    label: "En attente",
    color: "bg-amber-50 text-amber-700 border-amber-200",
  };
}

function formatType(type: string) {
  if (type === "ADD" || type === "CREATE_PERSON") {
    return {
      label: "+ Ajout",
      color: "bg-violet-50 text-violet-700 border-violet-200",
    };
  }

  return {
    label: "✏ Modification",
    color: "bg-amber-50 text-amber-700 border-amber-200",
  };
}
---

<Baselayout title={`${user.prenom} ${user.nom}`}>
  <div class="max-w-4xl mx-auto px-6 py-8 space-y-6">

    <!-- HEADER -->
    <div class="flex items-center justify-between flex-wrap gap-3">

      <a
        href="/users"
        class="inline-flex items-center gap-2 text-sm text-stone-500 hover:text-stone-800 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"
          />
        </svg>

        Retour
      </a>

      <div class="flex items-center gap-2">

        <a
          href={`/users/edit/${user._id}`}
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 012.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-1.414a2 2 0 01.586-1.414z"
            />
          </svg>

          Modifier
        </a>

          <!-- NOUVEAU : reset password -->
            <button
            id="reset-password"
            data-email={user.email}
            class="px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white text-sm font-medium transition"
            >
            Réinitialiser mot de passe
            </button>

      </div>
    </div>

    <!-- CARTE IDENTITÉ -->
    <div class="bg-white border border-stone-200 rounded-xl p-6">

      <div class="flex items-start gap-5">

        <!-- Avatar -->
        <div class="w-16 h-16 rounded-full bg-amber-50 border-2 border-amber-200 flex items-center justify-center shrink-0">
          <span class="text-xl font-semibold text-amber-700">
            {user.prenom?.charAt(0)?.toUpperCase()}
            {user.nom?.charAt(0)?.toUpperCase()}
          </span>
        </div>

        <!-- Infos -->
        <div class="flex-1 min-w-0">

          <div class="flex items-center gap-3 flex-wrap">

            <h1 class="text-2xl font-semibold text-stone-800 tracking-tight">
              {user.prenom} {user.nom}
            </h1>

            <span class={`px-2.5 py-1 rounded-full text-xs font-medium ${role.color}`}>
              {role.label}
            </span>

          </div>

          <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4">

            <div>
              <p class="text-xs text-stone-400 mb-1">
                Email
              </p>

              <p class="text-sm font-medium text-stone-800 break-all">
                {user.email}
              </p>
            </div>

            <div>
              <p class="text-xs text-stone-400 mb-1">
                Rôle
              </p>

              <p class="text-sm font-medium text-stone-800">
                {role.label}
              </p>
            </div>

            <div>
              <p class="text-xs text-stone-400 mb-1">
                Inscription
              </p>

              <p class="text-sm font-medium text-stone-800">
                {new Date(user.createdAt).toLocaleDateString("fr-FR")}
              </p>
            </div>

          </div>

        </div>

      </div>
    </div>

    <!-- GRILLE INFOS -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

      <!-- Permissions -->
      <div class="bg-white border border-stone-200 rounded-xl p-5">

        <div class="flex items-center gap-2 mb-4">
          <div class="w-6 h-6 rounded-md bg-amber-50 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-amber-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 11c0 .552-.448 1-1 1s-1-.448-1-1 .448-1 1-1 1 .448 1 1zm0 0V9m0 4v2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>

          <h3 class="text-xs font-semibold text-stone-500 uppercase tracking-wider">
            Permissions
          </h3>
        </div>

        <div class="space-y-2">

          {user.role === "OWNER" ? (
            <>
              <div class="flex items-center justify-between text-sm">
                <span class="text-stone-500">Administration</span>
                <span class="text-emerald-600 font-medium">Oui</span>
              </div>

              <div class="flex items-center justify-between text-sm">
                <span class="text-stone-500">Gestion utilisateurs</span>
                <span class="text-emerald-600 font-medium">Oui</span>
              </div>

              <div class="flex items-center justify-between text-sm">
                <span class="text-stone-500">Modification données</span>
                <span class="text-emerald-600 font-medium">Oui</span>
              </div>
            </>
          ) : (
            <>
              <div class="flex items-center justify-between text-sm">
                <span class="text-stone-500">Lecture</span>
                <span class="text-emerald-600 font-medium">Oui</span>
              </div>

              <div class="flex items-center justify-between text-sm">
                <span class="text-stone-500">Modification</span>
                <span class="text-red-500 font-medium">Non</span>
              </div>

              <div class="flex items-center justify-between text-sm">
                <span class="text-stone-500">Administration</span>
                <span class="text-red-500 font-medium">Non</span>
              </div>
            </>
          )}

        </div>
      </div>

      <!-- Compte -->
      <div class="bg-white border border-stone-200 rounded-xl p-5">

        <div class="flex items-center gap-2 mb-4">
          <div class="w-6 h-6 rounded-md bg-stone-100 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-stone-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5.121 17.804A9 9 0 1118 21H6a1 1 0 01-.879-1.496z"
              />
            </svg>
          </div>

          <h3 class="text-xs font-semibold text-stone-500 uppercase tracking-wider">
            Compte
          </h3>
        </div>

        <div class="space-y-3">

          <div>
            <p class="text-xs text-stone-400 mb-1">
              ID utilisateur
            </p>

            <p class="text-sm font-mono text-stone-700 break-all">
              {user._id.toString()}
            </p>
          </div>

          <div>
            <p class="text-xs text-stone-400 mb-1">
              Créé le
            </p>

            <p class="text-sm text-stone-700">
              {new Date(user.createdAt).toLocaleString("fr-FR")}
            </p>
          </div>

        </div>
      </div>

    </div>

    <!-- DEMANDES DE MODÉRATION -->
<div class="bg-white border border-stone-200 rounded-xl p-5">

    <div class="flex items-center gap-2 mb-5">
      <div class="w-6 h-6 rounded-md bg-violet-50 flex items-center justify-center">
        <svg
          class="w-3.5 h-3.5 text-violet-600"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12h6m-6 4h6M7 4h10a2 2 0 012 2v12a2 2 0 01-2 2H7a2 2 0 01-2-2V6a2 2 0 012-2z"
          />
        </svg>
      </div>
  
      <h3 class="text-xs font-semibold text-stone-500 uppercase tracking-wider">
        Demandes de modération
      </h3>
  
      <span class="ml-auto text-xs text-stone-400">
        {moderationRequests.length}
      </span>
    </div>
  
    {moderationRequests.length > 0 ? (
  
      <div class="space-y-3">
  
        {moderationRequests.map((r) => {
          const status = formatStatus(r.status);
          const type   = formatType(r.type);
  
          return (
  
            <div class="rounded-xl border border-stone-200 p-4 bg-stone-50/50">
  
              <!-- HEADER -->
              <div class="flex items-start justify-between gap-3 flex-wrap mb-3">
  
                <div class="flex items-center gap-2 flex-wrap">
  
                  <span class={`inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium border ${type.color}`}>
                    {type.label}
                  </span>
  
                  <span class={`inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium border ${status.color}`}>
                    {status.label}
                  </span>
  
                </div>
  
                <span class="text-xs text-stone-400">
                  {new Date(r.createdAt).toLocaleDateString("fr-FR")}
                </span>
  
              </div>
  
              <!-- CONTENT -->
              <div class="space-y-2">
  
                {(r.proposedData?.prenom || r.proposedData?.nom) && (
                  <div>
                    <p class="text-xs text-stone-400 mb-1">
                      Personne concernée
                    </p>
  
                    <p class="text-sm font-medium text-stone-800">
                      {r.proposedData?.prenom} {r.proposedData?.nom}
                    </p>
                  </div>
                )}
  
                {r.reviewNote && (
                  <div>
                    <p class="text-xs text-stone-400 mb-1">
                      Note
                    </p>
  
                    <p class="text-sm text-stone-600 italic">
                      {r.reviewNote}
                    </p>
                  </div>
                )}
  
              </div>
  
            </div>
          );
        })}
  
      </div>
  
    ) : (
  
      <p class="text-sm text-stone-400">
        Aucune demande de modération
      </p>
  
    )}
  </div>

  </div>
</Baselayout>

<script>
    const btn = document.getElementById('reset-password')
    
    if (btn) {
      btn.addEventListener('click', async () => {
        const email = btn.dataset.email
    
        if (!email) {
          alert("Email introuvable")
          return
        }
    
        const confirmSend = confirm(
          `Envoyer un lien de réinitialisation à ${email} ?`
        )
    
        if (!confirmSend) return
    
        btn.disabled = true
        btn.textContent = "Envoi..."
    
        const res = await fetch('/api/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        })
    
        if (res.ok) {
          alert("Email envoyé avec succès")
        } else {
          const data = await res.json()
          alert(data.error || "Erreur lors de l'envoi")
        }
    
        btn.disabled = false
        btn.textContent = "Réinitialiser mot de passe"
      })
    }
    </script>