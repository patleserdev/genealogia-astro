---
import Baselayout from "../layouts/Baselayout.astro";
import { persons } from "../lib/mongo";

const data = await persons.find({ active: true }).toArray();
const personsList = data.map(p => ({
  _id: p._id!.toString(),
  prenom: p.prenom,
  nom: p.nom,
  dateNaissance: p.dateNaissance,
  email: p.email
}));
---

<Baselayout title="Accueil">
  <h1 class="text-2xl font-bold mb-6 text-gray-800">Genealogia</h1>
  <p class="text-lg font-medium mb-6 text-gray-800">Projet d'arbre généalogique</p>
  
  <ul>
    <li>Afficher la liste des personnes (voir, modifier, supprimer)</li>
    <li>Ajouter une personne</li>
    <li>Afficher la liste des relations (voir, modifier, supprimer)</li>
    <li>Ajouter une relation</li>
  </ul>
</Baselayout>

<script>
  document.querySelectorAll(".delete-btn").forEach(btn => {
    btn.addEventListener("click", async () => {
      const id = btn.getAttribute("data-id");
      const nom = btn.getAttribute("data-nom");

      if (!confirm(`Voulez-vous vraiment supprimer ${nom} ?`)) return;

      await fetch(`/api/persons/${id}`, { method: "DELETE" });
      window.location.reload();
    });
  });
</script>