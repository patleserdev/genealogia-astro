---
import BaseLayout from "../layouts/BaseLayout.astro";

const res = await fetch("http://localhost:4321/api/persons");
const persons = await res.json();
---

<BaseLayout title="Accueil">
  <h2 class="text-2xl font-bold mb-6 text-gray-800">Liste des personnes</h2>

  <div class="grid gap-4">
    {persons.map((p) => (
      <div class="bg-white shadow-md rounded-lg p-4 flex justify-between items-center">
        <div>
          <p class="font-semibold text-gray-800">{p.prenom} {p.nom}</p>
          {p.dateNaissance && <p class="text-sm text-gray-500">Né(e) le : {p.dateNaissance}</p>}
          {p.email && <p class="text-sm text-gray-500">Email : {p.email}</p>}
        </div>

        <div class="flex gap-2 items-center justify-center">
          <!-- Voir / profil éventuellement -->
          <a
            href={`/person/${p._id}`}
            class="text-blue-600 hover:underline text-sm font-medium"
          >
            Voir
          </a>

          <!-- Bouton supprimer -->
          <button
            class="bg-red-600 text-white px-3 py-1 rounded-md hover:bg-red-700 text-sm font-medium transition-colors"
            onClick={async () => {
              if (!confirm(`Voulez-vous vraiment supprimer ${p.prenom} ${p.nom} ?`)) return;

              await fetch(`/api/persons/${p._id}`, { method: "DELETE" });
              window.location.reload();
            }}
          >
            Supprimer
          </button>
        </div>
      </div>
    ))} 
  </div>
</BaseLayout>
