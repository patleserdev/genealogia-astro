---
import Baselayout from "../layouts/Baselayout.astro";
import { persons } from "../lib/mongo";
import { verifyToken } from "../lib/auth";

const token = Astro.cookies.get('token')?.value
let currentUser = null
if (token) {
  try { currentUser = verifyToken(token) } catch {}
}
const registrationEnabled = import.meta.env.PUBLIC_REGISTRATION_ENABLED !== 'false'

const data = await persons.find({ active: true }).toArray();
const today = new Date();

const personsList = data
  .filter((p) => {
    if (!p.dateNaissance) return false;
    const birth = new Date(p.dateNaissance);
    return (
      birth.getDate() === today.getDate() &&
      birth.getMonth() === today.getMonth()
    );
  })
  .map((p) => ({
    _id: p._id!.toString(),
    prenom: p.prenom,
    nom: p.nom,
    dateNaissance: p.dateNaissance,
  }));

const totalPersons = data.length;
---

<Baselayout title="Accueil">
  <div class="min-h-[75vh] bg-stone-50">

    <!-- Hero -->
    <div class="bg-amber-800 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="tree" x="0" y="0" width="60" height="60" patternUnits="userSpaceOnUse">
              <circle cx="30" cy="30" r="1.5" fill="white"/>
              <line x1="30" y1="30" x2="30" y2="15" stroke="white" stroke-width="1"/>
              <line x1="30" y1="22" x2="20" y2="14" stroke="white" stroke-width="0.8"/>
              <line x1="30" y1="22" x2="40" y2="14" stroke="white" stroke-width="0.8"/>
              <line x1="20" y1="14" x2="14" y2="8"  stroke="white" stroke-width="0.6"/>
              <line x1="20" y1="14" x2="26" y2="8"  stroke="white" stroke-width="0.6"/>
              <line x1="40" y1="14" x2="34" y2="8"  stroke="white" stroke-width="0.6"/>
              <line x1="40" y1="14" x2="46" y2="8"  stroke="white" stroke-width="0.6"/>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#tree)"/>
        </svg>
      </div>

      <div class="relative z-10 max-w-4xl mx-auto px-6 py-14 flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-semibold text-white tracking-tight">Genealogia</h1>
          <p class="text-amber-200 mt-1 text-sm">Projet d'arbre généalogique familial</p>
          <div class="flex items-center gap-2 mt-4">
            <span class="px-3 py-1 bg-white/15 rounded-full text-xs text-amber-100">
              {totalPersons} personne{totalPersons > 1 ? 's' : ''} dans l'arbre
            </span>
          </div>
        </div>

        <div class="flex items-center gap-3">
          {currentUser ? (
            <a href="/profil"
              class="inline-flex items-center gap-2 px-4 py-2 bg-white/15 hover:bg-white/25 text-white text-sm font-medium rounded-lg transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              Mon profil
            </a>
          ) : (
            <>
              <a href="/login"
                class="px-4 py-2 bg-white text-amber-800 hover:bg-amber-50 text-sm font-medium rounded-lg transition-colors">
                Se connecter
              </a>
             { !registrationEnabled && <a href="/register"
                class="px-4 py-2 bg-transparent hover:bg-white hover:text-amber-700 border border-white text-white hover:border-amber-50 text-sm font-medium rounded-lg transition-colors">
                S'inscrire
              </a>}
            </>
          )}
        </div>
      </div>
    </div>

    <!-- Contenu principal -->
    <div class="max-w-4xl mx-auto px-6 py-10 space-y-6">

      <!-- Navigation rapide -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <a href="/persons"
          class="bg-white border border-stone-200 rounded-xl p-4 hover:border-amber-300 hover:shadow-sm transition group">
          <div class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center mb-3 group-hover:bg-amber-100 transition">
            <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/>
            </svg>
          </div>
          <p class="text-sm font-medium text-stone-800">Personnes</p>
          <p class="text-xs text-stone-400 mt-0.5">Voir & gérer</p>
        </a>

        <a href="/persons/new"
          class="bg-white border border-stone-200 rounded-xl p-4 hover:border-amber-300 hover:shadow-sm transition group">
          <div class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center mb-3 group-hover:bg-amber-100 transition">
            <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
          </div>
          <p class="text-sm font-medium text-stone-800">Ajouter</p>
          <p class="text-xs text-stone-400 mt-0.5">Nouvelle personne</p>
        </a>

        <a href="/relations"
          class="bg-white border border-stone-200 rounded-xl p-4 hover:border-amber-300 hover:shadow-sm transition group">
          <div class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center mb-3 group-hover:bg-amber-100 transition">
            <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
            </svg>
          </div>
          <p class="text-sm font-medium text-stone-800">Relations</p>
          <p class="text-xs text-stone-400 mt-0.5">Voir & gérer</p>
        </a>

        <a href="/relations/add"
          class="bg-white border border-stone-200 rounded-xl p-4 hover:border-amber-300 hover:shadow-sm transition group">
          <div class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center mb-3 group-hover:bg-amber-100 transition">
            <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M12 4v16m8-8H4"/>
            </svg>
          </div>
          <p class="text-sm font-medium text-stone-800">Lier</p>
          <p class="text-xs text-stone-400 mt-0.5">Nouvelle relation</p>
        </a>
      </div>

      <!-- Anniversaires du jour -->
      {currentUser &&<div class="bg-white rounded-2xl border border-stone-200 shadow-sm p-6">
         <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center">
            <span class="text-base">🎂</span>
          </div>
          <h2 class="text-sm font-medium text-stone-800">Anniversaires du jour</h2>
          {personsList.length > 0 && (
            <span class="ml-auto px-2 py-0.5 bg-amber-100 text-amber-700 text-xs font-medium rounded-full">
              {personsList.length}
            </span>
          )}
        </div>

        {personsList.length === 0 ? (
          <div class="flex items-center gap-3 py-2">
            <p class="text-sm text-stone-400">Aucun anniversaire aujourd'hui</p>
          </div>
        ) : (
          <div class="space-y-2">
            {personsList.map(p => {
              const birth = new Date(p.dateNaissance!)
              const age   = today.getFullYear() - birth.getFullYear()
              return (
                <div class="flex items-center justify-between px-4 py-3 bg-stone-50 rounded-xl">
                  <div class="flex items-center gap-3">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    <div>
                      <p class="text-sm font-medium text-stone-800">{p.prenom} {p.nom}</p>
                      <p class="text-xs text-stone-400">Né(e) le {p.dateNaissance}</p>
                    </div>
                  </div>
                  <span class="text-xs font-medium text-amber-700 bg-amber-50 border border-amber-200 px-2 py-1 rounded-lg">
                    {age} ans
                  </span>
                </div>
              )
            })}
          </div>
        )}
      </div>}

    </div>
  </div>
</Baselayout>