---
import Baselayout from "../layouts/Baselayout.astro";
import { persons } from "../lib/mongo";
import { ObjectId } from "mongodb";

export const prerender = false;

// Récupération des paramètres
const id = Astro.url.searchParams.get("id");
const returnUrl = Astro.url.searchParams.get("returnUrl") || "/persons";

let person = null;
if (id) {
  person = await persons.findOne({ _id: new ObjectId(id) });
}
---

<Baselayout title={person ? "Modifier une personne" : "Ajouter une personne"}>

  <h2 class="text-2xl font-bold mb-6 text-gray-800">
    {person ? `Modifier ${person.prenom} ${person.nom}` : "Ajouter une personne"}
  </h2>

  <form id="form" class="bg-white shadow-md rounded-lg p-6 max-w-md mx-auto space-y-4">

    <!-- Prénom -->
    <div class="flex flex-col">
      <label class="mb-1 font-medium text-gray-700">Prénom</label>
      <input
        name="prenom"
        placeholder="Prénom"
        required
        value={person?.prenom ?? ""}
        class="border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <!-- Nom -->
    <div class="flex flex-col">
      <label class="mb-1 font-medium text-gray-700">Nom</label>
      <input
        name="nom"
        placeholder="Nom"
        required
        value={person?.nom ?? ""}
        class="border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <!-- Email -->
    <div class="flex flex-col">
      <label class="mb-1 font-medium text-gray-700">Adresse email</label>
      <input
        type="email"
        name="email"
        placeholder="Adresse email"
        value={person?.email ?? ""}
        class="border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <!-- Date de naissance -->
    <div class="flex flex-col">
      <label class="mb-1 font-medium text-gray-700">Date de naissance</label>
      <input
        type="date"
        name="dateNaissance"
        value={person?.dateNaissance ?? ""}
        class="border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <div class="flex flex-col">
      <label class="mb-1 font-medium text-gray-700">Date de décès</label>
      <input
        type="date"
        name="dateDeces"
        value={person?.dateDeces ?? ""}
        class="border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <!-- Sexe -->
    <div class="flex flex-col">
      <label class="mb-1 font-medium text-gray-700">Sexe</label>
      <select
        name="sexe"
        class="border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <option value="M" selected={person?.sexe === "M"}>Homme</option>
        <option value="F" selected={person?.sexe === "F"}>Femme</option>
        <option value="Autre" selected={person?.sexe === "Autre"}>Autre</option>
      </select>
    </div>

    <button
      type="submit"
      class="w-full bg-blue-600 text-white font-semibold px-4 py-2 rounded-md hover:bg-blue-700 transition-colors"
    >
      {person ? "Enregistrer les modifications" : "Ajouter"}
    </button>

    <!-- Bouton Annuler intelligent -->
    <a
      href={returnUrl}
      class="block text-center text-sm text-gray-500 hover:underline"
    >
      Annuler
    </a>

  </form>

  <script define:vars={{ personId: id, returnUrl }}>
    const form = document.getElementById("form");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));

      if (personId) {
        await fetch(`/api/persons/${personId}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
      } else {
        await fetch("/api/persons", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
      }

      // Redirection vers la page d'origine
      window.location.href = returnUrl;
    });
  </script>

</Baselayout>