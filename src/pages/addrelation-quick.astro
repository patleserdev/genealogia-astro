---
import Baselayout from "../layouts/Baselayout.astro";
import { persons as personsCol, relations as relationsCol } from "../lib/mongo";
import { formatFullName } from "../utils/formatName.ts";

export const prerender = false;

const persons = await personsCol.find({ active: true }).toArray();
const allPersonsForCouples = await personsCol.find({}).toArray();  // ← pour les labels
const coupleRelations = await relationsCol.find({ type: "CONJOINT" }).toArray();

function isMajeur(dateNaissance?: string): boolean {
  if (!dateNaissance) return true;
  const birth = new Date(dateNaissance);
  const majority = new Date(birth);
  majority.setFullYear(majority.getFullYear() + 18);
  return majority <= new Date();
}

const personsData = persons
  .map((p) => ({
    _id: p._id!.toString(),
    prenom: p.prenom,
    nom: p.nom,
    majeur: isMajeur(p.dateNaissance),
  }))
  .sort((a, b) => a.nom.localeCompare(b.nom, "fr"));

  const coupleRelationsData = coupleRelations.map((r) => {
  // ← utiliser allPersonsForCouples au lieu de personsData
  const p1 = allPersonsForCouples.find((p) => p._id!.toString() === r.from.toString());
  const p2 = allPersonsForCouples.find((p) => p._id!.toString() === r.to.toString());
  return {
    _id: r._id!.toString(),
    fromId: r.from.toString(),
    toId: r.to.toString(),
    label: p1 && p2
      ? `${formatFullName(p1.prenom, p1.nom)} & ${formatFullName(p2.prenom, p2.nom)}`
      : r._id!.toString(),
  };
});
---

<Baselayout title="Connecter deux personnes">
  <div class="max-w-xl mx-auto">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">🔗 Connecter deux personnes</h2>

    <div class="bg-white rounded-2xl shadow-md border p-6 space-y-6">

      <!-- ÉTAPE 1 : Choisir personne A -->
      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1">
          Personne A
        </label>
        <input
          id="searchA"
          type="text"
          placeholder="Rechercher par nom…"
          class="w-full rounded-lg border-gray-300 focus:ring-2 focus:ring-blue-500 mb-1"
          autocomplete="off"
        />
        <ul id="resultsA" class="border border-gray-200 rounded-lg hidden max-h-48 overflow-y-auto divide-y divide-gray-100"></ul>
        <input type="hidden" id="personA" />
        <p id="selectedA" class="text-sm text-blue-700 font-medium mt-1 hidden"></p>
      </div>

      <!-- ÉTAPE 2 : Type de relation -->
      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1">
          Type de relation
        </label>
        <div class="flex gap-3">
          <button type="button" id="btnConjoint"
            class="flex-1 py-2 rounded-xl border-2 border-blue-500 bg-blue-50 text-blue-700 font-semibold text-sm transition"
            data-type="CONJOINT">
            💍 Conjoint
          </button>
          <button type="button" id="btnParent"
            class="flex-1 py-2 rounded-xl border-2 border-gray-200 text-gray-500 font-semibold text-sm transition"
            data-type="PARENT">
            👨‍👧 Parent de
          </button>
          <button type="button" id="btnEnfant"
            class="flex-1 py-2 rounded-xl border-2 border-gray-200 text-gray-500 font-semibold text-sm transition"
            data-type="ENFANT">
            👶 Enfant de
          </button>
        </div>
        <input type="hidden" id="relationType" value="CONJOINT" />
      </div>

      <!-- ÉTAPE 3 : Choisir personne B -->
      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1">
          Personne B
        </label>
        <input
          id="searchB"
          type="text"
          placeholder="Rechercher par nom…"
          class="w-full rounded-lg border-gray-300 focus:ring-2 focus:ring-blue-500 mb-1"
          autocomplete="off"
        />
        <ul id="resultsB" class="border border-gray-200 rounded-lg hidden max-h-48 overflow-y-auto divide-y divide-gray-100"></ul>
        <input type="hidden" id="personB" />
        <p id="selectedB" class="text-sm text-blue-700 font-medium mt-1 hidden"></p>
      </div>

      <!-- Options CONJOINT -->
      <div id="optionsConjoint" class="space-y-3">
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1">Statut</label>
          <select id="conjointStatus" class="w-full rounded-lg border-gray-300">
            <option value="ACTIVE">✅ En couple</option>
            <option value="DIVORCED">❌ Divorcé</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-gray-600 mb-1">Date début</label>
            <input type="date" id="dateDebut" class="w-full rounded-lg border-gray-300" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-600 mb-1">Date fin</label>
            <input type="date" id="dateFin" class="w-full rounded-lg border-gray-300" />
          </div>
        </div>
      </div>

      <!-- Options PARENT -->
      <div id="optionsParent" class="hidden space-y-3">
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1">Couple associé (optionnel)</label>
          <select id="coupleRelationId" class="w-full rounded-lg border-gray-300">
            <option value="">— Aucun couple —</option>
          </select>
        </div>
      </div>

      <!-- Récapitulatif -->
      <div id="recap" class="hidden bg-blue-50 border border-blue-200 rounded-xl p-3 text-sm text-blue-800"></div>

      <!-- Bouton -->
      <button
        id="btnSubmit"
        type="button"
        disabled
        class="w-full bg-blue-600 text-white font-semibold py-3 rounded-xl hover:bg-blue-700 transition shadow-md disabled:opacity-40 disabled:cursor-not-allowed"
      >
        ➕ Créer la relation
      </button>
    </div>

    <a href="/relations" class="mt-4 inline-block text-sm text-gray-400 hover:underline">← Retour aux relations</a>
  </div>
</Baselayout>

<script define:vars={{ personsData, coupleRelationsData }}>
  let selectedA = null;
  let selectedB = null;
  let relationType = "CONJOINT";

  const typeLabels = { CONJOINT: "💍 Conjoint", PARENT: "👨‍👧 Parent de", ENFANT: "👶 Enfant de" };

  // --- Recherche ---
  function setupSearch(inputId, resultsId, hiddenId, selectedLabelId, onSelect) {
    const input = document.getElementById(inputId);
    const results = document.getElementById(resultsId);

    input.addEventListener("input", () => {
      const q = input.value.toLowerCase().trim();
      results.innerHTML = "";
      if (!q) { results.classList.add("hidden"); return; }

      const matches = personsData.filter(p =>
        `${p.prenom} ${p.nom}`.toLowerCase().includes(q) ||
        p.nom.toLowerCase().includes(q)
      ).slice(0, 8);

      if (!matches.length) { results.classList.add("hidden"); return; }

      matches.forEach(p => {
        const li = document.createElement("li");
        li.className = "px-3 py-2 hover:bg-blue-50 cursor-pointer text-sm text-gray-700";
        li.textContent = `${p.prenom} ${p.nom}`;
        li.addEventListener("click", () => {
          onSelect(p);
          input.value = `${p.prenom} ${p.nom}`;
          results.classList.add("hidden");
        });
        results.appendChild(li);
      });
      results.classList.remove("hidden");
    });

    document.addEventListener("click", (e) => {
      if (!input.contains(e.target) && !results.contains(e.target)) {
        results.classList.add("hidden");
      }
    });
  }

  setupSearch("searchA", "resultsA", "personA", "selectedA", (p) => {
    selectedA = p;
    document.getElementById("selectedA").textContent = `✓ ${p.prenom} ${p.nom}`;
    document.getElementById("selectedA").classList.remove("hidden");
    updateCoupleSuggestions();
    updateRecap();
    updateSubmit();
  });

  setupSearch("searchB", "resultsB", "personB", "selectedB", (p) => {
    selectedB = p;
    document.getElementById("selectedB").textContent = `✓ ${p.prenom} ${p.nom}`;
    document.getElementById("selectedB").classList.remove("hidden");
    updateCoupleSuggestions();
    updateRecap();
    updateSubmit();
  });

  // --- Type buttons ---
  const typeBtns = document.querySelectorAll("[data-type]");
  typeBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      relationType = btn.dataset.type;
      document.getElementById("relationType").value = relationType;

      typeBtns.forEach(b => {
        b.classList.remove("border-blue-500", "bg-blue-50", "text-blue-700");
        b.classList.add("border-gray-200", "text-gray-500");
      });
      btn.classList.add("border-blue-500", "bg-blue-50", "text-blue-700");
      btn.classList.remove("border-gray-200", "text-gray-500");

      document.getElementById("optionsConjoint").classList.toggle("hidden", relationType !== "CONJOINT");
      document.getElementById("optionsParent").classList.toggle("hidden", relationType === "CONJOINT");

      updateCoupleSuggestions();
      updateRecap();
      updateSubmit();
    });
  });

  // --- Suggestions couples selon personnes sélectionnées ---
  function updateCoupleSuggestions() {
  const select = document.getElementById("coupleRelationId");
  select.innerHTML = '<option value="">— Aucun couple —</option>';

  let filtered = coupleRelationsData;

  if (selectedA || selectedB) {
    const ids = [selectedA?._id, selectedB?._id].filter(Boolean);
    // ← Garder les couples dont AU MOINS UN membre est dans la sélection
    filtered = filtered.filter(c =>
      ids.some(id => c.fromId === id || c.toId === id)
    );
  }

  filtered.forEach(c => {
    const opt = document.createElement("option");
    opt.value = c._id;
    opt.textContent = c.label;
    select.appendChild(opt);
  });

  // Auto-sélectionner si un seul couple correspond exactement aux deux personnes
  if (selectedA && selectedB) {
    const exact = filtered.find(c =>
      (c.fromId === selectedA._id && c.toId === selectedB._id) ||
      (c.fromId === selectedB._id && c.toId === selectedA._id)
    );
    if (exact) select.value = exact._id;
    else if (filtered.length === 1) select.value = filtered[0]._id;
  } else if (filtered.length === 1) {
    select.value = filtered[0]._id;
  }
}
  // --- Récap ---
  function updateRecap() {
    const recap = document.getElementById("recap");
    if (!selectedA || !selectedB) { recap.classList.add("hidden"); return; }
    if (selectedA._id === selectedB._id) {
      recap.textContent = "⚠️ Vous ne pouvez pas relier une personne à elle-même.";
      recap.classList.remove("hidden");
      return;
    }

    const nameA = `${selectedA.prenom} ${selectedA.nom}`;
    const nameB = `${selectedB.prenom} ${selectedB.nom}`;

    const texts = {
      CONJOINT: `${nameA} et ${nameB} seront en couple.`,
      PARENT: `${nameA} sera parent de ${nameB}.`,
      ENFANT: `${nameA} sera enfant de ${nameB}.`,
    };
    recap.textContent = `✅ ${texts[relationType]}`;
    recap.classList.remove("hidden");
  }

  function updateSubmit() {
    const btn = document.getElementById("btnSubmit");
    btn.disabled = !selectedA || !selectedB || selectedA._id === selectedB._id;
  }

  // --- Submit ---
  document.getElementById("btnSubmit").addEventListener("click", async () => {
    if (!selectedA || !selectedB || selectedA._id === selectedB._id) return;

    let payload = {};

    if (relationType === "CONJOINT") {
      payload = {
        type: "CONJOINT",
        from: selectedA._id,
        to: selectedB._id,
        status: document.getElementById("conjointStatus").value,
        dateDebut: document.getElementById("dateDebut").value || null,
        dateFin: document.getElementById("dateFin").value || null,
      };
    } else {
      const coupleRelationId = document.getElementById("coupleRelationId").value;
      payload = {
        type: "PARENT",
        from: relationType === "PARENT" ? selectedA._id : selectedB._id,
        to: relationType === "PARENT" ? selectedB._id : selectedA._id,
        ...(coupleRelationId ? { coupleRelationId } : {}),
      };
    }

    const res = await fetch("/api/relations", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });

    if (!res.ok) {
      alert("Erreur : " + await res.text());
      return;
    }

    alert("Relation créée !");
    window.location.href = "/relations";
  });
</script>