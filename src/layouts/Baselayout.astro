---
// Baselayout.astro
const { title = "Arbre généalogique" } = Astro.props;
import "../styles/global.css";
import { verifyToken } from "../lib/auth";
import { changeRequests, notifications } from "../lib/mongo";
import { ObjectId } from "mongodb";

const token = Astro.cookies.get("token")?.value;
let payload = null;
if (token) {
  try {
    payload = verifyToken(token);
  } catch {}
  // pas de redirect ici — c'est le rôle du middleware
}

const isOwner = payload?.role === "OWNER";

let pendingModerationCount = 0;

if (isOwner) {
  pendingModerationCount = await changeRequests.countDocuments({
    status: "PENDING",
  });
}

console.log("pendingModerationCount",pendingModerationCount)

const registrationEnabled = import.meta.env.DEMO_MODE !== "false";
let unreadNotifications = 0;

if (payload?.userId) {
  unreadNotifications = await notifications.countDocuments({
    userId: new ObjectId(payload.userId),
    read: false,
  });
  console.log("ununreadNotifications",unreadNotifications)
}

const nav = [
  { href: "/", label: "Accueil", ownerOnly: false },
  { href: "/persons", label: "Personnes", ownerOnly: false },
  { href: "/relations", label: "Relations", ownerOnly: false },
  { href: "/invitations", label: "Invitations", ownerOnly: true },
  {
    href: "/moderation",
    label: "Modération",
    ownerOnly: false,
    badge: isOwner ? pendingModerationCount:unreadNotifications,
  },
  
  { href: "/relations/add-quick", label: "Relation rapide", ownerOnly: true },
  {
    href: "/persons/add-with-relations",
    label: "Personne + Relation",
    ownerOnly: true,
  },
  { href: "/users", label: "Utilisateurs", ownerOnly: true },
  { href: "/faq", label: "FAQ", ownerOnly: true },
].filter((item) => !item.ownerOnly || isOwner);


---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="view-transition" content="same-origin" />
    <title>{title}</title>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"
    ></script>

    <style>
      html {
        overflow-y: scroll;
      }

      @view-transition {
        navigation: auto;
      }

      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
      }

      ::view-transition-old(hero-banner),
      ::view-transition-new(hero-banner) {
        animation: none;
      }

      /* Sortie : l'ancienne page disparaît */
      ::view-transition-old(main-content) {
        animation: 150ms ease-in both fade-out;
      }

      /* Entrée : la nouvelle page apparaît APRÈS la sortie */
      ::view-transition-new(main-content) {
        animation: 200ms ease-out 150ms both fade-in;
      }

      @keyframes fade-out {
        from {
          opacity: 1;
        }
        to {
          opacity: 0;
        }
      }

      @keyframes fade-in {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
    </style>
  </head>

  <body class="bg-stone-50 text-stone-900 font-sans min-h-screen flex flex-col">
    <div
      transition:name="hero-banner"
      class="relative h-[10vh] overflow-hidden mt-14"
    >
      <img
        class="w-full h-full object-cover object-[100%_50%]"
        src="/pexels-thiago-jose-amaral-3362454-6274899.jpg"
      />
      <div class="absolute inset-0 flex items-center">
        <div
          class="w-full h-full flex items-center justify-center bg-[rgba(225,113,0,0.2)]"
        >
          <div class="max-w-6xl mx-auto px-4 w-full">
            <h1
              class="text-white text-lg sm:text-2xl md:text-3xl font-bold drop-shadow-lg tracking-wide"
            >
              Genealogia
            </h1>
            <h2
              class="text-white text-sm sm:text-base md:text-xl italic drop-shadow-lg tracking-wide"
            >
              Site familial d'informations généalogiques
            </h2>
          </div>
        </div>
      </div>
    </div>
    <!-- HEADER -->
    <header
      class="bg-white border-b border-stone-200 fixed top-0 left-0 right-0 z-50 h-14 pr-[var(--scrollbar-width)]"
    >
      <div
        class="max-w-6xl mx-auto px-4 h-full flex items-center justify-between gap-4"
      >
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 shrink-0">
          <div
            class="w-7 h-7 rounded-lg bg-amber-100 flex items-center justify-center"
          >
            <svg
              class="w-4 h-4 text-amber-700"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197"
              ></path>
            </svg>
          </div>
          <span class="font-semibold text-stone-800 text-sm">Genealogia</span>
        </a>

        <!-- Nav desktop -->
        <nav
        id="desktopNav"
        class="hidden lg:flex flex-1 px-4 items-center justify-center"
        >
        <div class="flex items-center gap-1 relative">
          {
          nav
          .filter(i => !i.ownerOnly)
          .map(({ href, label, badge }) => (
          <a
            href={href}
            data-navlink
            class="relative px-3 py-2 text-sm font-medium text-stone-500 hover:text-stone-900 transition-colors"
          >
            <span class="relative z-10 flex items-center gap-1">
              {label}

              {badge != undefined && badge > 0 && (
                <span class="ml-1 min-w-[16px] h-[16px] px-1 rounded-full bg-red-500 text-white text-[10px] flex items-center justify-center">
                  {badge}
                </span>
              )}
            </span>

            <!-- underline animé -->
            <span
              class="nav-underline absolute left-1/2 -translate-x-1/2 -bottom-1 h-[2px] w-0 bg-stone-900 rounded-full transition-all duration-300"
            ></span>
          </a>
        ))
    }

    <!-- ADMIN DROPDOWN -->
    {isOwner && (
      <div class="relative" x-data="{ open: false }">
        <button
          @click="open = !open"
          class="px-3 py-2 text-sm font-medium text-stone-500 hover:text-stone-900 transition-colors flex items-center gap-1"
        >
          Admin
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6" />
          </svg>
        </button>

        <div
          x-show="open"
          @click.outside="open = false"
          class="absolute right-0 mt-2 w-48 bg-white border border-stone-200 rounded-xl shadow-lg py-1 z-50"
        >
          {nav
            .filter(i => i.ownerOnly)
            .map(i => (
              <a
                href={i.href}
                class="block px-3 py-2 text-sm text-stone-600 hover:bg-stone-100"
              >
                {i.label}
              </a>
            ))}
        </div>
      </div>
    )}
  </div>
</nav>

        <!-- Actions droite -->
        <div class="hidden lg:flex items-center gap-2 shrink-0">
          {
            payload ? (
              <div class="flex items-center gap-2">
                <a
                  href="/profil"
                  class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm text-stone-600 hover:text-stone-800 hover:bg-stone-100 transition-colors font-medium"
                >
                  <div class="w-6 h-6 rounded-full bg-amber-100 flex items-center justify-center">
                    <svg
                      class="w-3.5 h-3.5 text-amber-700"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                      />
                    </svg>
                  </div>
                  <span class="uppercase">
                    {payload.nom} {payload.prenom.slice(0, 1)}
                  </span>
                </a>
                <a
                  href="/api/auth/logout"
                  class="px-3 py-1.5 rounded-lg text-sm text-stone-400 hover:text-red-500 hover:bg-red-50 transition-colors font-medium"
                >
                  Déconnexion
                </a>
              </div>
            ) : (
              <div class="flex items-center gap-2">
                <a
                  href="/login"
                  class="px-3 py-1.5 rounded-lg text-sm text-stone-600 hover:text-stone-800 hover:bg-stone-100 transition-colors font-medium"
                >
                  Se connecter
                </a>
                {!registrationEnabled && (
                  <a
                    href="/register"
                    class="px-3 py-1.5 rounded-lg text-sm bg-amber-600 hover:bg-amber-700 text-white transition-colors font-medium"
                  >
                    S'inscrire
                  </a>
                )}
              </div>
            )
          }
        </div>

        <!-- Burger mobile -->
        <button
          id="burger"
          aria-label="Menu"
          class="lg:hidden flex flex-col justify-center gap-1.5 p-2 rounded-lg hover:bg-stone-100 transition-colors"
        >
          <span
            class="block w-5 h-0.5 bg-stone-600 rounded transition-all duration-200"
            id="b1"></span>
          <span
            class="block w-5 h-0.5 bg-stone-600 rounded transition-all duration-200"
            id="b2"></span>
          <span
            class="block w-5 h-0.5 bg-stone-600 rounded transition-all duration-200"
            id="b3"></span>
        </button>
      </div>
    </header>

    <!-- Mobile menu -->
    <!-- Mobile menu -->
<div
  id="mobileMenu"
  class="hidden fixed top-14 left-0 right-0 z-40 bg-white border-b border-stone-200 px-4 py-3"
>
  <!-- Navigation principale -->
  <div class="space-y-0.5">
    {
      nav
        .filter((i) => !i.ownerOnly)
        .map(({ href, label, badge }) => (
          <a
            href={href}
            data-navlink
            class="flex items-center justify-between px-3 py-2 rounded-lg text-sm text-stone-600 hover:text-stone-800 hover:bg-stone-100 transition-colors font-medium"
          >
            <span>{label}</span>

            {badge != undefined && badge > 0 && (
              <span class="min-w-[18px] h-[18px] px-1 rounded-full bg-red-500 text-white text-[10px] flex items-center justify-center">
                {badge}
              </span>
            )}
          </a>
        ))
    }
  </div>

  <!-- Bloc admin -->
  {
    isOwner && (
      <div class="mt-3 pt-3 border-t border-stone-100">
        <div x-data="{ open: false }">
          <button
            @click="open = !open"
            class="w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium text-amber-700 bg-amber-50 hover:bg-amber-100 transition-colors"
          >
            <span>Administration</span>

            <svg
              class="w-4 h-4 transition-transform"
              :class="{ 'rotate-180': open }"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"
              />
            </svg>
          </button>

          <div x-show="open" x-transition class="mt-2 space-y-1">
            {
              nav
                .filter((i) => i.ownerOnly)
                .map(({ href, label }) => (
                  <a
                    href={href}
                    class="block px-3 py-2 rounded-lg text-sm text-stone-600 hover:text-stone-800 hover:bg-stone-100 transition-colors"
                  >
                    {label}
                  </a>
                ))
            }
          </div>
        </div>
      </div>
    )
  }

  <!-- Compte -->
  <div class="h-px bg-stone-100 my-3"></div>

  {
    payload ? (
      <>
        <a
          href="/profil"
          class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-stone-600 hover:bg-stone-100 transition-colors font-medium"
        >
          <div class="w-5 h-5 rounded-full bg-amber-100 flex items-center justify-center">
            <svg
              class="w-3 h-3 text-amber-700"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              />
            </svg>
          </div>

          {payload.nom} — Mon profil
        </a>

        <a
          href="/api/auth/logout"
          class="block px-3 py-2 rounded-lg text-sm text-red-500 hover:bg-red-50 transition-colors font-medium"
        >
          Déconnexion
        </a>
      </>
    ) : (
      <div class="space-y-1">
        <a
          href="/login"
          class="block px-3 py-2 rounded-lg text-sm text-stone-600 hover:bg-stone-100 transition-colors font-medium"
        >
          Se connecter
        </a>

        {!registrationEnabled && (
          <a
            href="/register"
            class="block px-3 py-2 rounded-lg text-sm bg-amber-600 hover:bg-amber-700 text-white transition-colors font-medium text-center"
          >
            S'inscrire
          </a>
        )}
      </div>
    )
  }
</div>

    <!-- MAIN -->
    <main class="flex-1" transition:name="main-content">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="border-t border-stone-200 py-4 px-4 text-center">
      <p class="text-xs text-stone-400">© 2026 — Genealogia</p>
    </footer>

    <script>
      let burgerInitialized = false;

      function initMenu() {
        const burger = document.getElementById("burger");
        const mobileMenu = document.getElementById("mobileMenu");

        if (!burger || !mobileMenu) return;

        const spans = burger.querySelectorAll("span");
        const [b1, b2, b3] = Array.from(spans);

        function close() {
          mobileMenu?.classList.add("hidden");
          b1?.classList.remove("translate-y-2", "rotate-45");
          b2?.classList.remove("opacity-0");
          b3?.classList.remove("-translate-y-2", "-rotate-45");
        }

        close();

        // N'attacher le listener burger qu'une seule fois
        if (!burgerInitialized) {
          burgerInitialized = true;

          burger.addEventListener("click", () => {
            const isOpen = mobileMenu.classList.toggle("hidden") === false;
            b1?.classList.toggle("translate-y-2", isOpen);
            b1?.classList.toggle("rotate-45", isOpen);
            b2?.classList.toggle("opacity-0", isOpen);
            b3?.classList.toggle("-translate-y-2", isOpen);
            b3?.classList.toggle("-rotate-45", isOpen);
          });

          window
            .matchMedia("(min-width: 1024px)")
            .addEventListener("change", (e) => {
              if (e.matches) close();
            });
        }

        // Liens du menu mobile — re-attacher à chaque navigation car le menu est dans le <body> qui change
        mobileMenu.querySelectorAll("a").forEach((a) => {
          a.addEventListener("click", close);
        });

        // Liens actifs
        const path = window.location.pathname;
        document.querySelectorAll("[data-navlink]").forEach((a) => {
          a.classList.remove("text-stone-800");
          a.classList.add("text-stone-500");
          if (a.getAttribute("href") === path) {
            a.classList.add("text-stone-800");
            a.classList.remove("text-stone-500");
          }
        });
      }

      function initScrollbar() {
        document.documentElement.style.setProperty(
          "--scrollbar-width",
          `${window.innerWidth - document.documentElement.clientWidth}px`,
        );
      }

      function initBackToTop() {
        const btn = document.getElementById("back-to-top");
        if (!btn) return;

        const toggle = () => {
          const past50vh = window.scrollY > window.innerHeight * 0.5;
          btn.classList.toggle("opacity-0", !past50vh);
          btn.classList.toggle("translate-y-4", !past50vh);
          btn.classList.toggle("pointer-events-none", !past50vh);
        };

        window.addEventListener("scroll", toggle, { passive: true });
        toggle(); // état initial

        btn.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      }

      document.addEventListener("DOMContentLoaded", () => {
        initScrollbar();
        initMenu();
        initBackToTop();
      });

      document.addEventListener("astro:page-load", () => {
        initScrollbar();
        initMenu();
        initBackToTop();
      });
    </script>

    <!-- Back to top -->
    <button
      id="back-to-top"
      aria-label="Retour en haut"
      class="fixed bottom-6 right-6 z-50 w-10 h-10 rounded-full bg-amber-600 hover:bg-amber-700 text-white shadow-lg flex items-center justify-center transition-all duration-300 opacity-0 translate-y-4 pointer-events-none"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5 15l7-7 7 7"></path>
      </svg>
    </button>
  </body>
</html>
