{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/addperson/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/persons/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/relations/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/relations/?$",
			"dest": "_render"
		},
		{
			"src": "^/person/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/relations/?$",
			"dest": "_render"
		}
	]
}